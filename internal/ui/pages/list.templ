package pages

import (
	"fmt"
	"github.com/marcosalvi-01/gowatch/internal/models"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/button"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/dialog"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/icon"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/selectbox"
	"strconv"
)

templ List(data models.ListViewData) {
	@Layout() {
		@templ.Fragment("content") {
			@listHeader(data)
			<div
				id="list-movie-grid"
				hx-get={ data.GridURL }
				hx-trigger="load, refreshListGrid from:body"
				hx-swap="innerHTML"
				hx-target="this"
			></div>
		}
	}
}

templ listHeader(data models.ListViewData) {
	<div class="space-y-6 mb-8">
		<div class="rounded-2xl border bg-card/40 p-5 sm:p-6">
			<div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
				<div class="space-y-3">
					<div class="flex items-center gap-3">
						<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
							@icon.List(icon.Props{Class: "size-5"})
						</div>
						<div class="space-y-1">
						{{
							title := data.List.Name
							if data.List.IsWatchlist {
								title = "My Watchlist"
							}
						}}
						if data.IsEditing && !data.List.IsWatchlist {
							@listDetailsForm(data)
						} else {
							<h1 class="text-2xl sm:text-3xl font-bold tracking-tight">{ title }</h1>
						}
						</div>
					</div>
					if !data.IsEditing && data.List.Description != nil && *data.List.Description != "" {
						<p class="text-muted-foreground text-sm sm:text-base max-w-3xl leading-relaxed">
							{ *data.List.Description }
						</p>
					}
					<div class="flex flex-wrap gap-2 text-xs sm:text-sm text-muted-foreground">
						<span class="inline-flex items-center rounded-full border px-3 py-1 font-medium bg-background/70">
							@icon.Film(icon.Props{Class: "size-3.5 mr-2"})
							{ fmt.Sprintf("%d movies", len(data.List.Movies)) }
						</span>
						<span class="inline-flex items-center rounded-full border px-3 py-1 font-medium bg-background/70">
							@icon.Calendar(icon.Props{Class: "size-3.5 mr-2"})
							Created { data.List.CreationDate.Format("Jan 2006") }
						</span>
						if data.HasAverageRating {
							<span class="inline-flex items-center rounded-full border px-3 py-1 font-medium bg-background/70">
								@icon.Star(icon.Props{Class: "size-3.5 mr-2 fill-[orange] stroke-[orange]"})
								{ fmt.Sprintf("%.1f avg rating", data.AverageRating) }
							</span>
						}
					</div>
					if data.List.IsWatchlist {
						<div
							id="list-stats"
							hx-get={ fmt.Sprintf("/htmx/lists/%d/stats", data.List.ID) }
							hx-trigger="load, refreshListStats from:body"
							hx-swap="innerHTML"
						></div>
					}
				</div>
				<div class="flex w-full flex-col gap-3 lg:w-auto lg:min-w-[16rem] lg:items-end">
					@listSortForm(data)
					<div class="flex flex-wrap justify-end gap-2">
						@listEditAction(data)
						if data.IsEditing && !data.List.IsWatchlist {
							@listActions(data.List)
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ listDetailsForm(data models.ListViewData) {
	<form id="list-details-form" class="space-y-2">
		<input
			class="h-10 w-full rounded-md border border-input bg-background px-3 text-2xl sm:text-3xl font-bold tracking-tight"
			name="title"
			value={ data.List.Name }
			maxlength="100"
			required
		/>
		<textarea
			class="min-h-20 w-full rounded-md border border-input bg-background px-3 py-2 text-sm sm:text-base leading-relaxed"
			name="description"
			maxlength="500"
			placeholder="Add a description"
		>
			if data.List.Description != nil {
				{ *data.List.Description }
			}
		</textarea>
	</form>
}


templ listSortForm(data models.ListViewData) {
	<form
		class="w-full"
		hx-patch={ fmt.Sprintf("/htmx/lists/%d/display-sort", data.List.ID) }
		hx-target="#toast"
		hx-trigger="change"
	>
		if data.IsEditing {
			<input type="hidden" name="edit" value="1"/>
		}
		<div class="space-y-2">
			<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Display order</p>
			@selectbox.SelectBox(selectbox.Props{Class: "w-full lg:w-64"}) {
				@selectbox.Trigger(selectbox.TriggerProps{Name: "sort", Class: "w-full lg:w-64", Disabled: !data.IsEditing}) {
					@selectbox.Value(selectbox.ValueProps{Placeholder: "Sort movies"})
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortCustom), Selected: data.Sort == models.ListMovieSortCustom}) {
						Custom order
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortDateAddedDesc), Selected: data.Sort == models.ListMovieSortDateAddedDesc}) {
						Recently added
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortDateAddedAsc), Selected: data.Sort == models.ListMovieSortDateAddedAsc}) {
						Oldest added
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortTitleAsc), Selected: data.Sort == models.ListMovieSortTitleAsc}) {
						Title A-Z
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortRatingDesc), Selected: data.Sort == models.ListMovieSortRatingDesc}) {
						Highest rated
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortReleaseDateDesc), Selected: data.Sort == models.ListMovieSortReleaseDateDesc}) {
						Newest release
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortReleaseStatus), Selected: data.Sort == models.ListMovieSortReleaseStatus}) {
						Upcoming / Released
					}
				}
			}
		</div>
	</form>
}

templ listActions(list *models.List) {
	@deleteListDialog(list)
}

templ listEditAction(data models.ListViewData) {
	{{
			label := "Edit list"
			variant := button.VariantOutline
			attributes := templ.Attributes{
				"hx-get":      data.ToggleEditURL,
				"hx-target":   "#main-content",
				"hx-push-url": "true",
				"hx-swap":     "innerHTML",
			}
			if data.List.IsWatchlist {
				label = "Edit watchlist"
			}
			if data.IsEditing {
				label = "Done"
				variant = button.VariantDefault
				if !data.List.IsWatchlist {
					attributes = templ.Attributes{
						"hx-patch":   fmt.Sprintf("/htmx/lists/%d", data.List.ID),
						"hx-include": "#list-details-form",
						"hx-target":  "#toast",
					}
				}
			}
	}}
	@button.Button(button.Props{
			Variant: variant,
			Class:   "h-8 gap-2 px-3",
			Attributes: attributes,
	}) {
			@icon.Pencil(icon.Props{Class: "size-4"})
			{ label }
	}
}

templ deleteListDialog(list *models.List) {
	<form
		hx-delete="/htmx/lists"
		hx-target="#toast"
	>
		<input type="hidden" name="list_id" value={ strconv.FormatInt(list.ID, 10) }/>
		@dialog.Dialog(dialog.Props{
			ID: "delete-list-dialog",
		}) {
			@dialog.Trigger(dialog.TriggerProps{
				For: "delete-list-dialog",
			}) {
				@button.Button(button.Props{
					Variant: button.VariantDestructive,
					Size:    button.SizeSm,
				}) {
					@icon.Trash(icon.Props{Class: "size-4"})
					Delete List
				}
			}
			@dialog.Content(dialog.ContentProps{
				Class: "max-w-md",
			}) {
				@dialog.Header() {
					@dialog.Title() {
						Delete List
					}
					@dialog.Description() {
						Are you sure you want to delete <strong>{ list.Name }</strong>? This action cannot be undone.
					}
				}
				<div class="space-y-4">
					if len(list.Movies) > 0 {
						<div class="p-3 bg-destructive/10 rounded-lg">
							<p class="text-sm text-destructive">
								This list contains { fmt.Sprintf("%d", len(list.Movies)) } movie(s) that will be removed from the list.
							</p>
						</div>
					}
				</div>
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{
						For: "delete-list-dialog",
					}) {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Type:    button.TypeButton,
						}) {
							Cancel
						}
					}
					@dialog.Close(dialog.CloseProps{
						For: "delete-list-dialog",
					}) {
						@button.Button(button.Props{
							Variant: button.VariantDestructive,
							Type:    button.TypeSubmit,
						}) {
							Delete List
						}
					}
				}
			}
		}
	</form>
}
