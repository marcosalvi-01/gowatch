package pages

import (
	"fmt"
	"github.com/marcosalvi-01/gowatch/internal/models"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/button"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/dialog"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/icon"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/selectbox"
	"strconv"
)

templ List(data models.ListViewData) {
	@Layout() {
		@templ.Fragment("content") {
			@listHeader(data)
			<div
				id="list-movie-grid"
				hx-get={ data.GridURL }
				hx-trigger="load, refreshListGrid from:body"
				hx-swap="innerHTML"
				hx-target="this"
			></div>
		}
	}
}

templ listHeader(data models.ListViewData) {
	<div class="space-y-6 mb-8">
		<div class="rounded-2xl border bg-card/40 p-5 sm:p-6">
			<div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
				<div class="space-y-3">
					<div class="flex items-center gap-3">
						<div class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">
							@icon.List(icon.Props{Class: "size-5"})
						</div>
						<div class="space-y-1">
							<h1 class="text-2xl sm:text-3xl font-bold tracking-tight">{ data.List.Name }</h1>
						</div>
					</div>
					if data.List.Description != nil && *data.List.Description != "" {
						<p class="text-muted-foreground text-sm sm:text-base max-w-3xl leading-relaxed">
							{ *data.List.Description }
						</p>
					}
					<div class="flex flex-wrap gap-2 text-xs sm:text-sm text-muted-foreground">
						<span class="inline-flex items-center rounded-full border px-3 py-1 font-medium bg-background/70">
							@icon.Film(icon.Props{Class: "size-3.5 mr-2"})
							{ fmt.Sprintf("%d movies", len(data.List.Movies)) }
						</span>
						<span class="inline-flex items-center rounded-full border px-3 py-1 font-medium bg-background/70">
							@icon.Calendar(icon.Props{Class: "size-3.5 mr-2"})
							Created { data.List.CreationDate.Format("Jan 2006") }
						</span>
						if data.HasAverageRating {
							<span class="inline-flex items-center rounded-full border px-3 py-1 font-medium bg-background/70">
								@icon.Star(icon.Props{Class: "size-3.5 mr-2 fill-[orange] stroke-[orange]"})
								{ fmt.Sprintf("%.1f avg rating", data.AverageRating) }
							</span>
						}
					</div>
				</div>
				<div class="flex w-full flex-col gap-3 lg:w-auto lg:min-w-[16rem] lg:items-end">
					@listSortForm(data.PageURL, data.Sort)
					<div class="flex flex-wrap justify-end gap-2">
						@listEditOrderAction(data)
						@listActions(data.List)
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ listSortForm(pageURL string, currentSort models.ListMovieSort) {
	<form
		class="w-full"
		hx-get={ pageURL }
		hx-target="#main-content"
		hx-trigger="change"
		hx-push-url="true"
		hx-swap="innerHTML"
	>
		<div class="space-y-2">
			<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Display order</p>
			@selectbox.SelectBox(selectbox.Props{Class: "w-full lg:w-64"}) {
				@selectbox.Trigger(selectbox.TriggerProps{Name: "sort", Class: "w-full lg:w-64"}) {
					@selectbox.Value(selectbox.ValueProps{Placeholder: "Sort movies"})
				}
				@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortCustom), Selected: currentSort == models.ListMovieSortCustom}) {
						Custom order
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortDateAddedDesc), Selected: currentSort == models.ListMovieSortDateAddedDesc}) {
						Recently added
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortDateAddedAsc), Selected: currentSort == models.ListMovieSortDateAddedAsc}) {
						Oldest added
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortTitleAsc), Selected: currentSort == models.ListMovieSortTitleAsc}) {
						Title A-Z
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortRatingDesc), Selected: currentSort == models.ListMovieSortRatingDesc}) {
						Highest rated
					}
					@selectbox.Item(selectbox.ItemProps{Value: string(models.ListMovieSortReleaseDateDesc), Selected: currentSort == models.ListMovieSortReleaseDateDesc}) {
						Newest release
					}
				}
			}
		</div>
	</form>
}

templ listActions(list *models.List) {
	@deleteListDialog(list)
}

templ listEditOrderAction(data models.ListViewData) {
	if data.Sort == models.ListMovieSortCustom {
		{{
			label := "Edit order"
			variant := button.VariantOutline
			if data.IsEditingOrder {
				label = "Done"
				variant = button.VariantDefault
			}
		}}
		@button.Button(button.Props{
			Variant: variant,
			Class:   "h-8 gap-2 px-3",
			Attributes: templ.Attributes{
				"hx-get":      data.ToggleEditURL,
				"hx-target":   "#main-content",
				"hx-push-url": "true",
				"hx-swap":     "innerHTML",
			},
		}) {
			@icon.ListChevronsUpDown(icon.Props{Class: "size-4"})
			{ label }
		}
	}
}

templ deleteListDialog(list *models.List) {
	<form
		hx-delete="/htmx/lists"
		hx-target="#toast"
	>
		<input type="hidden" name="list_id" value={ strconv.FormatInt(list.ID, 10) }/>
		@dialog.Dialog(dialog.Props{
			ID: "delete-list-dialog",
		}) {
			@dialog.Trigger(dialog.TriggerProps{
				For: "delete-list-dialog",
			}) {
				@button.Button(button.Props{
					Variant: button.VariantDestructive,
					Size:    button.SizeSm,
				}) {
					@icon.Trash(icon.Props{Class: "size-4"})
					Delete List
				}
			}
			@dialog.Content(dialog.ContentProps{
				Class: "max-w-md",
			}) {
				@dialog.Header() {
					@dialog.Title() {
						Delete List
					}
					@dialog.Description() {
						Are you sure you want to delete <strong>{ list.Name }</strong>? This action cannot be undone.
					}
				}
				<div class="space-y-4">
					if len(list.Movies) > 0 {
						<div class="p-3 bg-destructive/10 rounded-lg">
							<p class="text-sm text-destructive">
								This list contains { fmt.Sprintf("%d", len(list.Movies)) } movie(s) that will be removed from the list.
							</p>
						</div>
					}
				</div>
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{
						For: "delete-list-dialog",
					}) {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Type:    button.TypeButton,
						}) {
							Cancel
						}
					}
					@dialog.Close(dialog.CloseProps{
						For: "delete-list-dialog",
					}) {
						@button.Button(button.Props{
							Variant: button.VariantDestructive,
							Type:    button.TypeSubmit,
						}) {
							Delete List
						}
					}
				}
			}
		}
	</form>
}
