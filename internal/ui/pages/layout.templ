// Package pages contains templated page layouts and views for the web interface.
package pages

import (
	"github.com/marcosalvi-01/gowatch/internal/ui/components/moviecard"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/sidebar"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/watcheddate"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/button"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/icon"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/input"
	templSidebar "github.com/marcosalvi-01/gowatch/internal/ui/shadcn/sidebar"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/skeleton"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/toast"
)

templ Layout() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Gowatch</title>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			@shadcn.Scripts()
			@Scripts()
			@Favicons()
		</head>
		<body class="bg-background">
			@toast.Toaster()
			@templSidebar.Provider(templSidebar.ProviderProps{
				Class: "w-full h-screen",
			}) {
				// by default show a loading version, when loading get the real sidebar content
				<div id="sidebar-content" hx-get="/htmx/sidebar" hx-target="this" hx-swap="innerHTML" hx-trigger="refreshSidebar from:body, load">
					@sidebar.SidebarLoading(false)
				</div>
				@templSidebar.Inset(templSidebar.InsetProps{Class: "min-w-0"}) {
					<div id="toast"></div>
					// Header
					<div class="flex items-center gap-2 p-2 flex-shrink-0 sticky z-10 top-0 border-b-1 bg-background">
						@templSidebar.Trigger(templSidebar.TriggerProps{
							Target: "sidebar",
						})
						@SearchBar("")
						@ThemeSwitcher()
					</div>
					<div class="relative flex flex-1 flex-col min-w-0 overflow-hidden h-full">
						@HomeLoading()
						@WatchedLoading()
						@StatsLoading()
						@MovieLoading()
						@PersonLoading()
						@SearchLoading()
						<div id="main-scroll-container" class="flex flex-1 flex-col overflow-auto w-full min-w-0">
							<div id="main-content" class="p-4 w-full max-w-full min-w-0">
								{ children... }
							</div>
						</div>
					</div>
				}
			}
		</body>
	</html>
}

templ AuthLayout() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Gowatch</title>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			@shadcn.Scripts()
			@Scripts()
			@Favicons()
		</head>
		<body class="bg-background min-h-screen flex items-center justify-center">
			@toast.Toaster()
			<div class="w-full max-w-md p-4">
				{ children... }
			</div>
			<div id="toast"></div>
		</body>
	</html>
}

templ mainContentLoading() {
	<div id="main-content-loading" class="htmx-indicator absolute inset-0 bg-background z-30 pointer-events-none">
		<div class="flex flex-col justify-center items-center h-full p-8">
			<div class="w-full max-w-3xl space-y-6">
				// Page title
				<div class="space-y-2">
					@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-48 rounded-lg"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-64 rounded-md"})
				</div>
				// Main content blocks
				<div class="space-y-4 pt-4">
					@skeleton.Skeleton(skeleton.Props{Class: "h-24 w-full rounded-lg"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-24 w-full rounded-lg"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-24 w-full rounded-lg"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-24 w-full rounded-lg"})
				</div>
				// Bottom action area
				<div class="flex justify-between items-center pt-6">
					@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-24 rounded-md"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-10 w-28 rounded-lg"})
				</div>
			</div>
		</div>
	</div>
}

templ ThemeSwitcher() {
	@button.Button(button.Props{
		Variant: button.VariantGhost,
		Size:    button.SizeIcon,
		Attributes: templ.Attributes{
			"data-theme-toggle": "",
			"aria-label":        "Toggle theme",
		},
	}) {
		@icon.Moon(icon.Props{Class: "dark:hidden"})
		@icon.Sun(icon.Props{Class: "hidden dark:inline-block"})
	}
}

templ Scripts() {
	<script src="/static/js/htmx.min.js"></script>
	@SidebarNavigationScript()
	@watcheddate.Script()
	@ThemeScript()
	<script defer src="/static/js/rating.js"></script>
	@moviecard.Script()
}

templ SidebarNavigationScript() {
	<script>
	document.addEventListener("DOMContentLoaded", () => {
	  const navSelector = "[data-sidebar=menu-button][data-nav-url], [data-sidebar=menu-sub-button][data-nav-url]";
	  const sidebarSelectedPathCookieName = "sidebar_selected_path";
	  const sidebarListsOpenCookieName = "sidebar_lists_open";
	  const sidebarCookieDurationSeconds = 60 * 60 * 24 * 7;

	  function getPath(url = window.location.pathname) {
		try {
		  const parsed = new URL(url, window.location.origin);
		  let path = parsed.pathname || "";
		  if (path.length > 1 && path.endsWith("/")) {
			path = path.slice(0, -1);
		  }
		  return path;
		} catch (_error) {
		  return "";
		}
	  }

	  function isSidebarPath(path) {
		if (
		  path === "/home" ||
		  path === "/watched" ||
		  path === "/watchlist" ||
		  path === "/stats" ||
		  path === "/admin/users"
		) {
		  return true;
		}

		return /^\/list\/\d+$/.test(path);
	  }

	  function setSidebarSelectedPath(path) {
		if (!path || !isSidebarPath(path)) {
		  return;
		}

		document.cookie = `${sidebarSelectedPathCookieName}=${path}; path=/; max-age=${sidebarCookieDurationSeconds}`;
	  }

	  function setSidebarListsOpen(isOpen) {
		document.cookie = `${sidebarListsOpenCookieName}=${isOpen ? "true" : "false"}; path=/; max-age=${sidebarCookieDurationSeconds}`;
	  }

	  function syncSidebarListsOpenFromDOM() {
		const listsCollapsible = document.querySelector(
		  "[data-sidebar-lists-collapsible='true']"
		);
		if (!listsCollapsible) {
		  return;
		}

		const isOpen = listsCollapsible.hasAttribute("data-open");
		setSidebarListsOpen(isOpen);
	  }

	  function syncSidebarSelection(path) {
		if (!isSidebarPath(path)) {
		  return;
		}

		updateSidebarActiveState(path);
		setSidebarSelectedPath(path);
	  }

	  function updateSidebarActiveState(url = window.location.pathname) {
		const path = getPath(url);
		const allNavButtons = document.querySelectorAll(navSelector);

		allNavButtons.forEach(btn => {
		  if (btn.getAttribute("data-nav-url") === path) {
			btn.setAttribute("data-active", "");
		  } else {
			btn.removeAttribute("data-active");
		  }
		});
	  }

	  const initialPath = getPath(window.location.pathname);
	  syncSidebarSelection(initialPath);

	  document.addEventListener("click", e => {
		const trigger = e.target.closest?.("[data-sidebar-lists-collapsible-trigger='true']");
		const sidebar = window.templ?.sidebar;
		if (!trigger || !sidebar || sidebar.isMobile() || sidebar.state("sidebar") !== "collapsed") return;
		sidebar.setOpen(true, "sidebar");
		if (trigger.closest("[data-sidebar-lists-collapsible]")?.hasAttribute("data-open")) {
		  e.preventDefault();
		  e.stopPropagation();
		}
	  }, true);

	  document.body.addEventListener("click", e => {
		const listsTrigger = e.target.closest("[data-sidebar-lists-collapsible-trigger='true']");
		if (listsTrigger) {
		  window.requestAnimationFrame(syncSidebarListsOpenFromDOM);
		}

		const navButton = e.target.closest("[data-nav-url]");
		if (!navButton) {
		  return;
		}

		const targetPath = getPath(navButton.getAttribute("data-nav-url") || "");
		if (!targetPath) {
		  return;
		}

		syncSidebarSelection(targetPath);
	  });

	  document.body.addEventListener("htmx:afterSwap", e => {
		if (!e.detail.target) {
		  return;
		}

		if (e.detail.target.id === "sidebar-content") {
		  syncSidebarListsOpenFromDOM();
		}
	  });

	  window.addEventListener("popstate", () => {
		const path = getPath(window.location.pathname);
		syncSidebarSelection(path);
	  });
	});
	</script>
}

templ ThemeScript() {
	<script>
	(() => {
	  const root = document.documentElement;
	  const lightThemeColor = "#ffffff";
	  const darkThemeColor = "#09090b";

	  const syncThemeColor = () => {
		const themeColorMeta = document.querySelector("meta[name='theme-color']");
		if (!themeColorMeta) {
		  return;
		}

		themeColorMeta.setAttribute("content", root.classList.contains("dark") ? darkThemeColor : lightThemeColor);
	  };

	  const saved = localStorage.getItem("theme");
	  const shouldBeDark = saved ? saved === "dark" : true;
	  if (shouldBeDark) {
	    root.classList.add("dark");
	  }
	  syncThemeColor();
	  document.addEventListener("DOMContentLoaded", syncThemeColor);

	  document.addEventListener("click", (event) => {
	    if (!event.target.closest?.("[data-theme-toggle]")) return;
	    const isDark = root.classList.toggle("dark");
	    localStorage.setItem("theme", isDark ? "dark" : "light");
	    syncThemeColor();
	  });
	})();
	</script>
}

templ Favicons() {
	<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
	<meta name="theme-color" content="#09090b"/>
}

templ skeletonDashboard() {
	<div>
		<div class="grid gap-6 md:grid-cols-3">
			for _ = range 3 {
				<div class="p-4">
					@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-20 mb-2"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-24 mb-4"})
					<div class="flex items-center gap-2">
						@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-12"})
						@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-4"})
					</div>
				</div>
			}
		</div>
		<div class="mt-4 p-4">
			@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-1/3 mb-6"})
			@skeleton.Skeleton(skeleton.Props{Class: "h-[240px] w-full rounded-md"})
		</div>
	</div>
}

templ SearchBar(searchContent string) {
	<div class="relative flex items-center flex-1">
		@icon.Search(icon.Props{Class: "absolute left-3 size-5 text-muted-foreground"})
		@input.Input(input.Props{
			Type:        "search",
			Placeholder: "Search movies or people...",
			Class:       "pl-10",
			Value:       searchContent,
			Name:        "q",
			Attributes: templ.Attributes{
				"hx-get":         "/search",
				"hx-trigger":     "input changed delay:300ms, search",
				"hx-target":      "#main-content",
				"hx-swap":        "innerHTML scroll:#main-scroll-container:top",
				"hx-replace-url": "true",
				"hx-include":     "this",
				"hx-indicator":   "#search-loading",
				"hx-sync":        "this:replace",
			},
		})
	</div>
}
