package pages

import (
	"fmt"

	"github.com/marcosalvi-01/gowatch/internal/models"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/calendarheatmap"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/emptystate"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/infohint"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/listcard"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/moviecard"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/sidebar"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/button"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/card"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/dialog"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/icon"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/skeleton"
	"github.com/marcosalvi-01/gowatch/internal/utils"
)

const homeMoviePreviewLimit = 10

templ Home(userName string, data models.HomeData) {
	@Layout() {
		@templ.Fragment("content") {
			<div class="space-y-7 sm:space-y-8 pb-5">
				if data.Stats.TotalWatched == 0 && len(data.RecentMovies) == 0 && data.WatchlistMovieCount == 0 {
					@sidebar.ImportDataDialog()
					@emptystate.EmptyState(emptystate.Props{
						Title:             fmt.Sprintf("Welcome to Gowatch, %s!", userName),
						Description:       "Your movie collection starts here.",
						Instruction:       "Search above to add movies, or import your watch history below.",
						ImportTitle:       "Import History",
						ImportDescription: "Bring your existing watch history.",
						ShowImport:        true,
					})
				} else {
					@homeHeader(userName)
					@homeAtGlance(data.Stats)
					if data.Stats.TotalWatched > 0 || len(data.RecentMovies) > 0 {
						@homeActivitySection(data.DailyWatchCountsLastYear, data.RecentMovies)
					}
					@homeWatchNextSection(data.WatchNextMovies, data.WatchlistMovieCount)
					<div hx-get="/htmx/lists/home-lists" hx-trigger="load, refreshLists from:body" hx-indicator="#lists-loading">
						@ListsLoading()
					</div>
				}
			</div>
		}
	}
}

templ homeSectionHeader(title string, iconFn func(...icon.Props) templ.Component) {
	<h2 class="text-xl font-semibold flex items-center gap-2">
		@iconFn(icon.Props{Class: "size-5 text-primary"})
		{ title }
	</h2>
}

templ homeHeader(name string) {
	<div class="flex flex-col gap-4 rounded-lg border bg-card/40 p-5 sm:flex-row sm:items-end sm:justify-between sm:p-6">
		<div class="space-y-2">
			<h1 class="text-3xl sm:text-4xl font-bold leading-tight">Welcome back, { name }</h1>
			<p class="text-muted-foreground text-sm sm:text-base max-w-2xl">Your recent watches and what's next.</p>
		</div>
		@button.Button(button.Props{Href: "/stats", Variant: button.VariantOutline, Size: button.SizeSm, Attributes: navAttrs("stats", "/stats", "#stats-loading")}) {
			@icon.ChartBar(icon.Props{Class: "size-4"})
			View Stats
		}
	</div>
}

templ homeAtGlance(stats models.HomeStatsSummary) {
	<div class="space-y-4">
		@homeSectionHeader("At a Glance", icon.Sparkles)
		@card.Card(card.Props{Class: "bg-card/40"}) {
			@card.Content(card.ContentProps{Class: "p-4 sm:p-6"}) {
				<div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
					@statsMetricCard("Total Watched", fmt.Sprintf("%d", stats.TotalWatched), icon.Film)
					@statsMetricCard("Avg per Week", fmt.Sprintf("%.1f", stats.AvgPerWeek), icon.TrendingUp)
					<div class="col-span-2 sm:col-span-1">
						if stats.TopGenre != nil {
							@statsMetricCard("Top Genre", stats.TopGenre.Name, icon.Tag)
						} else {
							@statsMetricCard("Top Genre", "No data", icon.Tag)
						}
					</div>
				</div>
				<div class="mt-4 flex items-center gap-2 border-t pt-4 text-xs text-muted-foreground">
					@infohint.Corner("Watches include rewatches. Weekly average covers your full history; top genre is ranked by watches.", "Overview help")
					<span>Across your full watch history</span>
				</div>
			}
		}
	</div>
}

templ homeActivitySection(heatmapData []models.DailyWatchCount, movies []models.WatchedMovieInDay) {
	<div class="space-y-4">
		@homeSectionHeader("Activity", icon.Activity)
		@calendarheatmap.CalendarHeatmapCard(heatmapData)
		@homeRecentActivityCard(movies)
	</div>
}

templ homeRecentActivityCard(movies []models.WatchedMovieInDay) {
	@card.Card(card.Props{Class: "h-full bg-card/40"}) {
		@card.Header(card.HeaderProps{Class: "flex-row flex-wrap items-center justify-between gap-3 space-y-0 p-4 pb-0"}) {
			@card.Title(card.TitleProps{Class: "text-sm font-semibold"}) {
				Recently Watched
			}
			@button.Button(button.Props{Href: "/watched", Variant: button.VariantGhost, Size: button.SizeSm, Attributes: navAttrs("watched", "/watched", "#watched-loading")}) {
				View All
				@icon.ArrowRight(icon.Props{Class: "size-4"})
			}
		}
		@card.Content(card.ContentProps{Class: "p-4 pt-3"}) {
			if len(movies) > 0 {
				<div class="flex gap-4 overflow-x-auto pb-2 px-1 -mx-1 scrollbar-hide">
					for i, movie := range movies {
						if i < homeMoviePreviewLimit {
							<div class="shrink-0">
								{{
									moviecardProps := moviecard.Props{
										Title:        movie.MovieDetails.Movie.Title,
										Href:         movieHref(movie.MovieDetails.Movie.ID),
										PosterPath:   movie.MovieDetails.Movie.PosterPath,
										Hoverable:    true,
										SeerrMovieID: movie.MovieDetails.Movie.ID,
									}
									if movie.InTheaters {
										moviecardProps.TopHoverComponent = movieCardTopHover(movie.InTheaters)
									}
								}}
								@moviecard.MovieCard(moviecardProps) {
									<h3 class="mb-1 text-xs md:text-sm font-bold leading-tight">{ movie.MovieDetails.Movie.Title }</h3>
									<div class="flex items-center justify-between">
										<div class="flex items-center">
											@icon.Calendar(icon.Props{Class: "size-3"})
											<p class="ml-2 text-xs opacity-90">{ utils.FormatYear(movie.MovieDetails.Movie.ReleaseDate) }</p>
										</div>
										if movie.Rating != nil {
											<div class="flex items-center">
												@icon.Star(icon.Props{Class: "size-3 fill-[orange] stroke-[orange]"})
												<span class="ml-1 text-xs">{ fmt.Sprintf("%.1f", *movie.Rating) }</span>
											</div>
										}
									</div>
								}
							</div>
						}
					}
				</div>
			} else {
				<div class="text-center text-muted-foreground py-8">No watches yet</div>
			}
		}
	}
}

templ homeWatchNextSection(movies []models.MovieItem, watchlistMovieCount int) {
	<div class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			@homeSectionHeader("Watch Next", icon.Bookmark)
			@button.Button(button.Props{Href: "/watchlist", Variant: button.VariantGhost, Size: button.SizeSm, Attributes: navAttrs("watchlist", "/watchlist", "#main-content-loading")}) {
				View Watchlist
				@icon.ArrowRight(icon.Props{Class: "size-4"})
			}
		</div>
		@card.Card(card.Props{Class: "h-full bg-card/40"}) {
			@card.Header(card.HeaderProps{Class: "flex-row flex-wrap items-center justify-between gap-2 space-y-0 p-4 pb-0"}) {
				<div class="flex items-center gap-2 text-sm text-muted-foreground">
					<span>From your watchlist</span>
					@infohint.Corner("Up next in your watchlist's custom order.", "Watch Next help")
				</div>
				if watchlistMovieCount > 0 {
					<p class="text-sm text-muted-foreground">{ fmt.Sprintf("%d in watchlist", watchlistMovieCount) }</p>
				}
			}
			@card.Content(card.ContentProps{Class: "p-4 pt-3"}) {
				if len(movies) > 0 {
					<div class="flex gap-4 overflow-x-auto pb-2 px-1 -mx-1 scrollbar-hide">
						for i, movie := range movies {
							<div class="shrink-0">
								@moviecard.MovieCard(moviecard.Props{
									Title:        movie.MovieDetails.Movie.Title,
									Href:         movieHref(movie.MovieDetails.Movie.ID),
									PosterPath:   movie.MovieDetails.Movie.PosterPath,
									Hoverable:    true,
									SeerrMovieID: movie.MovieDetails.Movie.ID,
								}) {
									<h3 class="mb-1 text-xs md:text-sm font-bold leading-tight">{ movie.MovieDetails.Movie.Title }</h3>
									<div class="flex items-center justify-between">
										<div class="flex items-center">
											@icon.Calendar(icon.Props{Class: "size-3"})
											<p class="ml-2 text-xs opacity-90">{ utils.FormatYear(movie.MovieDetails.Movie.ReleaseDate) }</p>
										</div>
										<span class="text-xs font-semibold text-primary">{ fmt.Sprintf("#%d", i+1) }</span>
									</div>
								}
							</div>
						}
					</div>
				} else {
					<div class="rounded-lg bg-muted/50 p-6 text-center">
						<p class="font-medium">Your watchlist is empty</p>
						<p class="text-sm text-muted-foreground mt-1">Search for movies to add to your watchlist.</p>
					</div>
				}
			}
		}
	</div>
}

templ HomeLists(lists []models.ListEntry) {
	<div class="space-y-4">
		<div class="flex flex-wrap items-center justify-between gap-3">
			@homeSectionHeader("Your Lists", icon.List)
			@dialog.Trigger(dialog.TriggerProps{For: "add-to-list-dialog"}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm}) {
					@icon.Plus(icon.Props{Class: "size-4"})
					New List
				}
			}
		</div>
		@card.Card(card.Props{Class: "bg-card/40"}) {
			@card.Content(card.ContentProps{Class: "p-4"}) {
				if len(lists) == 0 {
					<div class="rounded-lg bg-muted/50 p-6 text-center">
						<p class="font-medium">No lists yet</p>
						<p class="mt-1 text-sm text-muted-foreground">Create a list to group your movies.</p>
					</div>
				} else {
					<div id="lists-section" class="flex gap-4 overflow-x-auto pb-2 -mx-1 px-1 scrollbar-hide">
						for _, list := range lists {
							<div class="flex-shrink-0">
								@listcard.ListCard(listcard.Props{
									Name: list.Name,
									Href: fmt.Sprintf("/list/%d", list.ID),
								})
							</div>
						}
					</div>
				}
			}
		}
	</div>
}

templ HomeLoading() {
	<div id="home-loading" class="htmx-indicator absolute inset-0 bg-background z-30 pointer-events-none overflow-hidden">
		<div class="p-4 space-y-7 sm:space-y-8">
			// Header
			<div class="flex flex-col gap-4 rounded-lg border bg-card/40 p-5 sm:flex-row sm:items-end sm:justify-between sm:p-6">
				<div class="space-y-2">
					@skeleton.Skeleton(skeleton.Props{Class: "h-12 w-64 max-w-full rounded-lg"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-56 max-w-full rounded-md"})
				</div>
				@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-28 rounded-md"})
			</div>
			// At a glance section
			<div class="space-y-4">
				@skeleton.Skeleton(skeleton.Props{Class: "h-7 w-36 rounded-md"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-64 sm:h-48 w-full rounded-lg"})
			</div>
			// Activity section
			<div class="space-y-4">
				@skeleton.Skeleton(skeleton.Props{Class: "h-7 w-48 rounded-md"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-72 w-full rounded-lg"})
				@homeMovieRowLoading()
			</div>
			// Watch next section
			<div class="space-y-4">
				@skeleton.Skeleton(skeleton.Props{Class: "h-7 w-40 rounded-md"})
				@homeMovieRowLoading()
			</div>
			// Lists section
			<div class="space-y-4">
				@skeleton.Skeleton(skeleton.Props{Class: "h-7 w-28 rounded-md"})
				<div class="flex gap-4 overflow-x-auto pb-2">
					for range 6 {
						<div class="flex-shrink-0 w-[120px] md:w-[160px]">
							@skeleton.Skeleton(skeleton.Props{Class: "h-32 w-full rounded-lg"})
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

templ ListsLoading() {
	<div id="lists-loading" class="htmx-indicator">
		<div class="space-y-4">
			@skeleton.Skeleton(skeleton.Props{Class: "h-7 w-28 rounded-md"})
			<div class="flex gap-4 overflow-x-auto pb-4">
				for range 6 {
					<div class="flex-shrink-0 w-[120px] md:w-[160px]">
						@skeleton.Skeleton(skeleton.Props{Class: "h-32 w-full rounded-lg"})
					</div>
				}
			</div>
		</div>
	</div>
}

templ homeMovieRowLoading() {
	<div class="space-y-3 rounded-lg border bg-card/40 p-4">
		@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-36 rounded-md"})
		<div class="flex gap-4 overflow-x-auto pb-2">
			for range homeMoviePreviewLimit {
				<div class="shrink-0 w-[90px] sm:w-[120px] md:w-[160px]">
					@skeleton.Skeleton(skeleton.Props{Class: "aspect-[2/3] w-full rounded-lg"})
				</div>
			}
		</div>
	</div>
}
