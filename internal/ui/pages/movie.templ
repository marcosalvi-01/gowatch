package pages

import (
	"cmp"
	"fmt"
	"github.com/marcosalvi-01/gowatch/internal/models"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/avatar"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/badge"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/button"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/card"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/checkbox"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/collapsible"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/datepicker"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/dialog"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/dropdown"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/form"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/icon"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/rating"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/separator"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/skeleton"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/table"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/textarea"
	"github.com/marcosalvi-01/gowatch/internal/utils"
	"slices"
	"strconv"
	"strings"
	"time"
)

const movieVisibleCastLimit = 9

templ Movie(movie models.MovieDetails, watchRecords models.WatchedMovieRecords, isInWatchlist, hasLists bool) {
	@Layout() {
		@templ.Fragment("content") {
			@movieHero(movie, isInWatchlist, hasLists)
			@movieContent(movie, watchRecords)
		}
	}
}

templ movieHero(movie models.MovieDetails, isInWatchlist, hasLists bool) {
	<div class="relative -m-4 mb-6">
		if movie.Movie.BackdropPath != "" {
			@backdropHero(movie, isInWatchlist, hasLists)
		} else {
			@fallbackHero(movie, isInWatchlist, hasLists)
		}
		@separator.Separator()
	</div>
}

templ backdropHero(movie models.MovieDetails, isInWatchlist, hasLists bool) {
	<div class="relative w-full h-[36vh] min-h-[280px] max-h-[500px] sm:h-[45vh] md:h-[50vh] lg:h-[55vh] overflow-hidden">
		<!-- Background Image -->
		<img
			src={ utils.TMDBImageURL("w1280", movie.Movie.BackdropPath) }
			alt={ movie.Movie.Title + " backdrop" }
			class="absolute inset-0 w-full h-full object-cover object-top"
		/>
		<!-- Gradient Overlays -->
		<div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-transparent"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
		<div class="absolute inset-0 bg-gradient-to-r from-black/40 via-transparent to-black/20 sm:from-black/60 sm:via-transparent sm:to-black/20"></div>
		<!-- Content Container - Now uses flex items-center for better centering -->
		<div class="absolute inset-0 flex items-center">
			<div class="w-full p-4 sm:p-6 md:p-8 lg:p-10">
				<div class="max-w-6xl mx-auto w-full">
					@heroContent(movie, true, isInWatchlist, hasLists)
				</div>
			</div>
		</div>
	</div>
}

templ fallbackHero(movie models.MovieDetails, isInWatchlist, hasLists bool) {
	<div class="p-4 sm:p-6 md:p-8 lg:p-10 bg-muted/20">
		<div class="max-w-6xl mx-auto">
			@heroContent(movie, false, isInWatchlist, hasLists)
		</div>
	</div>
}

templ heroContent(movie models.MovieDetails, isDark, isInWatchlist, hasLists bool) {
	<div class="flex flex-col sm:flex-row gap-4 sm:gap-6 lg:gap-8 items-start">
		@posterSection(movie, isDark)
		@movieInfo(movie, isDark, isInWatchlist, hasLists)
	</div>
}

templ posterSection(movie models.MovieDetails, isDark bool) {
	if movie.Movie.PosterPath != "" {
		<div class="hidden sm:block flex-shrink-0">
			<div class="w-24 md:w-40 lg:w-48 xl:w-52">
				<div class="aspect-[2/3] rounded-lg overflow-hidden shadow-lg">
					<img
						src={ utils.TMDBImageURL("w500", movie.Movie.PosterPath) }
						alt={ movie.Movie.Title + " poster" }
						class="w-full h-full object-cover"
					/>
				</div>
			</div>
		</div>
	}
}

templ movieInfo(movie models.MovieDetails, isDark, isInWatchlist, hasLists bool) {
	<div class="flex-1 min-w-0 space-y-3 sm:space-y-4">
		<!-- Title -->
		<div>
			<h1
				class={
					"text-xl sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-bold leading-tight",
					templ.KV("text-white drop-shadow-2xl", isDark),
					templ.KV("text-foreground", !isDark),
				}
			>
				{ movie.Movie.Title }
			</h1>
		</div>
		<!-- Year and Director -->
		<div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
			<p
				class={
					"text-base sm:text-lg md:text-xl font-medium",
					templ.KV("text-white/90 drop-shadow-lg", isDark),
					templ.KV("text-muted-foreground", !isDark),
				}
			>
				{ utils.FormatYear(movie.Movie.ReleaseDate) }
			</p>
			if director := getDirector(movie.Credits.Crew); director.Person.Name != "" {
				<div class="flex items-center gap-2">
					<span
						class={
							"hidden sm:block text-sm",
							templ.KV("text-white/60", isDark),
							templ.KV("text-muted-foreground", !isDark),
						}
					>
						•
					</span>
					{{ personHref := personPagePath(director.Person.ID) }}
					<p
						class={
							"text-sm sm:text-base font-medium",
							templ.KV("text-white/90 drop-shadow-lg", isDark),
							templ.KV("text-foreground", !isDark),
						}
					>
						Directed by
					</p>
					if personHref != "" {
						<p
							data-page="person"
							hx-get={ personHref }
							hx-target="#main-content"
							hx-push-url="true"
							hx-swap="scroll:#main-scroll-container:top"
							hx-indicator="#person-loading"
							class={
								"text-sm sm:text-base font-medium cursor-pointer hover:underline",
								templ.KV("text-white/90 drop-shadow-lg", isDark),
								templ.KV("text-foreground", !isDark),
							}
						>
							{ director.Person.Name }
						</p>
					} else {
						<p
							class={
								"text-sm sm:text-base font-medium",
								templ.KV("text-white/90 drop-shadow-lg", isDark),
								templ.KV("text-foreground", !isDark),
							}
						>
							{ director.Person.Name }
						</p>
					}
				</div>
			}
		</div>
		<!-- Tagline -->
		if movie.Tagline != "" {
			<div class="max-w-2xl">
				<p
					class={
						"text-sm sm:text-base md:text-lg italic",
						templ.KV("text-white/85 drop-shadow-md", isDark),
						templ.KV("text-muted-foreground", !isDark),
					}
				>
					"{ movie.Tagline }"
				</p>
			</div>
		}
		<!-- Action Buttons -->
		@actionButtons(movie.Movie.ID, hasLists)
	</div>
}

templ actionButtons(movieID int64, hasLists bool) {
	<div class="grid w-full grid-cols-1 gap-2 pt-2 sm:grid-cols-3 sm:gap-3 sm:pt-4">
		<form
			class="w-full"
			hx-post="/htmx/movies/watched"
			hx-target="#toast"
			hx-on::after-request="this.reset()"
		>
			<input type="hidden" name="movie_id" value={ movieID }/>
			@dialog.Dialog(dialog.Props{
				ID: "default-dialog-watched",
			}) {
				@dialog.Trigger() {
					@button.Button(button.Props{Class: "w-full justify-center"}) {
						@icon.Check()
						Mark as Watched
					}
				}
				@dialog.Content(dialog.ContentProps{
					Class: "max-w-md",
				}) {
					@dialog.Header() {
						@dialog.Title() {
							Mark as Watched
						}
						@dialog.Description() {
							Mark this movie as watched by adding it to the Watched List. Click save when you're done.
						}
					}
					<div class="space-y-4">
						@watchedFormFields("add-watched", time.Now(), 0, false)
					</div>
					@dialog.Footer() {
						@dialog.Close() {
							@button.Button(button.Props{
								Variant: button.VariantOutline,
							}) {
								Cancel
							}
						}
						@dialog.Close() {
							@button.Button(button.Props{
								Type: button.TypeSubmit,
							}) {
								Add to Watched
							}
						}
					}
				}
			}
		</form>
		// TODO add hx-indicator for loading state?
		<form
			class={
				"w-full",
				templ.KV("hidden", !hasLists),
			}
			hx-post="/htmx/lists/items"
			hx-target="#toast"
			hx-on::after-request="this.reset()"
		>
			<input type="hidden" name="movie_id" value={ movieID }/>
			@dialog.Dialog(dialog.Props{
				ID: "add-movie-to-list-dialog",
			}) {
				if hasLists {
					@dialog.Trigger(dialog.TriggerProps{Class: "w-full"}) {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Class:   "w-full justify-center",
						}) {
							@icon.Plus()
							Add to List
						}
					}
				}
				@dialog.Content(dialog.ContentProps{
					Class: "max-w-md",
				}) {
					@dialog.Header() {
						@dialog.Title() {
							Add this Movie to a List
						}
						@dialog.Description() {
							Add this movie to a list to keep track of it in a specific way.
						}
					}
					<div class="space-y-4">
						<div
							hx-get="/htmx/lists/add-movie-dialog"
							hx-trigger="load, refreshLists from:body"
							hx-swap="innerHTML"
							hx-target="this"
						></div>
						<div class="space-y-2">
							@form.Label(form.LabelProps{
								For: "movie-note",
							}) {
								Add a note (optional)
							}
							@textarea.Textarea(textarea.Props{
								ID:          "movie-note",
								Name:        "note",
								Rows:        3,
								Placeholder: "Why did you add this movie to your list? Any thoughts or reminders...",
							})
						</div>
					</div>
					@dialog.Footer() {
						@dialog.Close() {
							@button.Button(button.Props{
								Variant: button.VariantOutline,
							}) {
								Cancel
							}
						}
						@dialog.Close() {
							@button.Button(button.Props{
								Type: button.TypeSubmit,
							}) {
								Add to List
							}
						}
					}
				}
			}
		</form>
		if !hasLists {
			@dialog.Trigger(dialog.TriggerProps{
				For:   "add-to-list-dialog",
				Class: "w-full",
			}) {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Class:   "w-full justify-center",
				}) {
					@icon.Plus()
					Create List
				}
			}
		}
		<div
			class="w-full [&_button]:w-full [&_button]:justify-center"
			hx-get={ fmt.Sprintf("/htmx/watchlist/%d", movieID) }
			hx-trigger="load, refreshWatchlist from:body"
			hx-swap="innerHTML"
			hx-target="this"
		></div>
	</div>
}

templ movieContent(movie models.MovieDetails, watchRecords models.WatchedMovieRecords) {
	<div class="space-y-7 pb-5 sm:space-y-8">
		@MovieActivity(watchRecords.Records)
		@movieMetadata(movie)
		@castSection(movie.Credits.Cast)
		@crewSection(movie.Credits.Crew)
	</div>
}

templ movieSectionHeader(title string, iconFn func(...icon.Props) templ.Component) {
	<h2 class="flex items-center gap-2 text-xl font-semibold">
		@iconFn(icon.Props{Class: "size-5 text-primary"})
		{ title }
	</h2>
}

templ MovieActivity(records []models.WatchedMovieRecord) {
	<div id="movie-activity-section">
		<div class="space-y-4">
			@movieSectionHeader("Your Activity", icon.Activity)
			@card.Card(card.Props{Class: "bg-card/40"}) {
				if len(records) > 0 {
					@card.Content(card.ContentProps{Class: "space-y-6 p-5 sm:p-6"}) {
						@activityStats(records)
						@separator.Separator()
						@watchHistory(records)
					}
				} else {
					@card.Content(card.ContentProps{Class: "flex items-center gap-3 p-5 sm:p-6"}) {
						@icon.Film(icon.Props{Class: "size-5 text-muted-foreground"})
						<div>
							<p class="font-medium">No activity yet</p>
							<p class="text-sm text-muted-foreground">Mark this movie as watched to start tracking your history.</p>
						</div>
					}
				}
			}
		</div>
	</div>
}

templ movieMetadata(movie models.MovieDetails) {
	<div class="space-y-4">
		@movieSectionHeader("Movie Details", icon.FileText)
		@card.Card(card.Props{Class: "bg-card/40"}) {
			@card.Content(card.ContentProps{Class: "space-y-6 p-5 sm:p-6"}) {
				if movie.Movie.Overview != "" {
					<div class="space-y-3">
						<h3 class="text-base font-semibold">Overview</h3>
						<p class="max-w-4xl text-sm leading-relaxed text-muted-foreground sm:text-base">{ movie.Movie.Overview }</p>
					</div>
				}
				if len(movie.Genres) > 0 {
					<div class="space-y-3">
						<h3 class="text-base font-semibold">Genres</h3>
						<div class="flex flex-wrap gap-2">
							for _, genre := range movie.Genres {
								@badge.Badge(badge.Props{Variant: "primary"}) {
									{ genre.Name }
								}
							}
						</div>
					</div>
				}
				if movie.Movie.Overview != "" || len(movie.Genres) > 0 {
					@separator.Separator()
				}
				<div class="space-y-3">
					<h3 class="text-base font-semibold">Release Information</h3>
					@table.Table() {
			@table.Body() {
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
						Release Date
					}
					@table.Cell() {
						{ utils.FormatLongDate(movie.Movie.ReleaseDate) }
					}
				}
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
						Runtime
					}
					@table.Cell() {
						{ fmt.Sprintf("%d minutes", movie.Runtime) }
					}
				}
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
						Rating
					}
					@table.Cell() {
						{ fmt.Sprintf("%.1f/10 (%s votes)", movie.Movie.VoteAverage, formatNumber(movie.Movie.VoteCount)) }
					}
				}
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
						Original Language
					}
					@table.Cell() {
						{ movie.Movie.OriginalLanguage }
					}
				}
				if movie.Budget > 0 {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							Budget
						}
						@table.Cell() {
							{ formatMoney(movie.Budget) }
						}
					}
				}
				if movie.Revenue > 0 {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							Revenue
						}
						@table.Cell() {
							{ formatMoney(movie.Revenue) }
						}
					}
				}
				@table.Row() {
					@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
						Status
					}
					@table.Cell() {
						{ movie.Status }
					}
				}
				if movie.IMDbID != "" {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							IMDB
						}
						@table.Cell() {
							<a href={ templ.URL("https://www.imdb.com/title/" + movie.IMDbID) } target="_blank" class="text-primary hover:underline flex items-center gap-1">
								View on IMDB
								@icon.ExternalLink(icon.Props{Class: "size-[14px]"})
							</a>
						}
					}
				}
					}
					}
				</div>
			}
		}
	</div>
}

templ castSection(cast []models.Cast) {
	if len(cast) > 0 {
		{{ sortedCast := sortCast(cast) }}
		<div class="space-y-4">
			@movieSectionHeader("Cast", icon.Users)
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				for i, member := range sortedCast {
					if i >= movieVisibleCastLimit {
						{{ break }}
					}
					@castMemberCard(member)
				}
			</div>
			if len(sortedCast) > movieVisibleCastLimit {
				@collapsible.Collapsible(collapsible.Props{Class: "group/collapsible mt-4"}) {
					@collapsible.Content(collapsible.ContentProps{Class: "mb-4"}) {
						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-1">
							for i, member := range sortedCast {
								if i < movieVisibleCastLimit {
									{{ continue }}
								}
								@castMemberCard(member)
							}
						</div>
					}
					@collapsible.Trigger(collapsible.TriggerProps{
						Class: "inline-flex items-center gap-2 text-sm font-medium text-primary cursor-pointer hover:underline",
						Attributes: templ.Attributes{
							"role":       "button",
							"tabindex":   "0",
							"aria-label": "Toggle full cast",
						},
					}) {
						<span class="group-data-[tui-collapsible-state=open]/collapsible:hidden">
							{ fmt.Sprintf("Show %d more cast members", len(sortedCast)-movieVisibleCastLimit) }
						</span>
						<span class="hidden group-data-[tui-collapsible-state=open]/collapsible:inline">
							Show less cast
						</span>
						@icon.ChevronRight(icon.Props{
							Class: "size-4 transition-transform group-data-[tui-collapsible-state=open]/collapsible:rotate-90",
						})
					}
				}
			}
		</div>
	}
}

templ castMemberCard(cast models.Cast) {
	{{ personHref := personPagePath(cast.Person.ID) }}
	@card.Card(card.Props{
		Class: "transition-colors duration-300",
	}) {
		if personHref != "" {
			<div
				data-page="person"
				hx-get={ personHref }
				hx-target="#main-content"
				hx-push-url="true"
				hx-swap="scroll:#main-scroll-container:top"
				hx-indicator="#person-loading"
				class="flex items-center space-x-3 p-2 cursor-pointer hover:bg-white/20"
			>
				@profileImage(cast.Person.ProfilePath, cast.Person.Name)
				<div class="flex-1 min-w-0">
					<p class="text-sm font-medium truncate">{ cast.Person.Name }</p>
					<p class="text-xs text-muted-foreground truncate">{ cast.Character }</p>
				</div>
			</div>
		} else {
			<div class="flex items-center space-x-3 p-2">
				@profileImage(cast.Person.ProfilePath, cast.Person.Name)
				<div class="flex-1 min-w-0">
					<p class="text-sm font-medium truncate">{ cast.Person.Name }</p>
					<p class="text-xs text-muted-foreground truncate">{ cast.Character }</p>
				</div>
			</div>
		}
	}
}

templ profileImage(profilePath, name string, class ...string) {
	{{ avatarClass := "" }}
	if len(class) > 0 {
		{{ avatarClass = class[0] }}
	}
	@avatar.Avatar(avatar.Props{Class: avatarClass}) {
		if profilePath != "" {
			@avatar.Image(avatar.ImageProps{
				Src:   utils.TMDBImageURL("w185", profilePath),
				Alt:   name,
				Class: "object-cover",
			})
		} else {
			@avatar.Fallback(avatar.FallbackProps{Class: "text-xs font-medium"}) {
				{ moviePersonInitials(name) }
			}
		}
	}
}

templ crewSection(crew []models.Crew) {
	{{ keyCrew := sortCrewByImportance(crew) }}
	if len(keyCrew) > 0 {
		<div class="space-y-4">
			@movieSectionHeader("Key Crew", icon.BriefcaseBusiness)
			<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
				for i, member := range keyCrew {
					if i >= movieVisibleCastLimit {
						{{ break }}
					}
					@crewMemberCard(member)
				}
			</div>
			if len(keyCrew) > movieVisibleCastLimit {
				@collapsible.Collapsible(collapsible.Props{Class: "group/collapsible mt-4"}) {
					@collapsible.Content(collapsible.ContentProps{Class: "mb-4"}) {
						<div class="grid grid-cols-1 gap-4 pt-1 sm:grid-cols-2 lg:grid-cols-3">
							for i, member := range keyCrew {
								if i < movieVisibleCastLimit {
									{{ continue }}
								}
								@crewMemberCard(member)
							}
						</div>
					}
					@collapsible.Trigger(collapsible.TriggerProps{
						Class: "inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-primary hover:underline",
						Attributes: templ.Attributes{
							"role":       "button",
							"tabindex":   "0",
							"aria-label": "Toggle full crew",
						},
					}) {
						<span class="group-data-[tui-collapsible-state=open]/collapsible:hidden">
							{ fmt.Sprintf("Show %d more crew members", len(keyCrew)-movieVisibleCastLimit) }
						</span>
						<span class="hidden group-data-[tui-collapsible-state=open]/collapsible:inline">
							Show less crew
						</span>
						@icon.ChevronRight(icon.Props{
							Class: "size-4 transition-transform group-data-[tui-collapsible-state=open]/collapsible:rotate-90",
						})
					}
				}
			}
		</div>
	}
}

templ crewMemberCard(crew models.Crew) {
	{{ personHref := personPagePath(crew.Person.ID) }}
	@card.Card(card.Props{Class: "transition-colors duration-300"}) {
		<div class="flex items-center gap-3 p-2">
			@profileImage(crew.Person.ProfilePath, crew.Person.Name, "h-8 w-8")
			<div class="min-w-0">
				<p class="text-xs text-muted-foreground">{ crew.Job }</p>
				if personHref != "" {
					<p
					data-page="person"
					hx-get={ personHref }
					hx-target="#main-content"
					hx-push-url="true"
					hx-swap="scroll:#main-scroll-container:top"
					hx-indicator="#person-loading"
						class="text-sm font-medium text-primary hover:underline cursor-pointer truncate"
				>
					{ crew.Person.Name }
					</p>
				} else {
					<p class="text-sm font-medium truncate">{ crew.Person.Name }</p>
				}
			</div>
		</div>
	}
}

templ activityStats(records []models.WatchedMovieRecord) {
	<div class="grid grid-cols-2 gap-4 sm:grid-cols-3 xl:grid-cols-5">
		@activityStat("Times Watched", fmt.Sprintf("%d", len(records)))
		@activityStat("In Theater", fmt.Sprintf("%d", countTheaterWatches(records)))
		@activityStat("At Home", fmt.Sprintf("%d", len(records)-countTheaterWatches(records)))
		@activityStat("Your Avg Rating", calculateAverageRating(records))
		if len(records) > 0 {
			@activityStat("Last Watched", getLastWatchDate(records).Format("Jan 2006"))
		}
	</div>
}

templ activityStat(label, value string) {
	<div class="rounded-lg bg-muted/50 p-3 text-center">
		<div class="text-2xl font-bold text-primary">{ value }</div>
		<div class="text-xs text-muted-foreground">{ label }</div>
	</div>
}

templ watchHistory(records []models.WatchedMovieRecord) {
	<div>
		<h3 class="text-sm font-medium mb-3">Watch History</h3>
		<div class="space-y-2 max-h-48 overflow-auto">
			for _, record := range sortWatchRecordsDesc(records) {
				@watchHistoryItem(record)
			}
		</div>
	</div>
}

templ watchHistoryItem(record models.WatchedMovieRecord) {
	{{
		editDialogID := fmt.Sprintf("edit-watched-%d", record.ID)
		deleteDialogID := fmt.Sprintf("delete-watched-%d", record.ID)
		watchedRating := 0.0
		if record.Rating != nil {
			watchedRating = *record.Rating
		}
	}}
	<div class="flex w-full items-center justify-between gap-3 rounded-lg bg-muted/50 py-2 pl-3">
		<div class="flex min-w-0 items-center gap-3">
			@watchLocationIcon(record.InTheaters)
			<div class="min-w-0">
				<div class="text-sm font-medium">
					if record.InTheaters {
						Theater
					} else {
						Home
					}
				</div>
				<div class="text-xs text-muted-foreground">{ record.Date.Format("January 2, 2006") }</div>
			</div>
			if record.Rating != nil {
				<div class="flex shrink-0 items-center">
					@rating.Rating(rating.Props{
						Value:     (*record.Rating),
						ReadOnly:  true,
						Precision: 0.5,
					}) {
						@rating.Group() {
							for i := 1; i <= 5; i++ {
								@rating.Item(rating.ItemProps{
									Value: i,
									Style: rating.StyleStar,
								})
							}
						}
					}
				</div>
			}
		</div>
		<div class="flex shrink-0 items-center gap-2">
			<div class="hidden text-xs text-muted-foreground sm:block">
				{ formatTimeAgo(record.Date) }
			</div>
			@dropdown.Dropdown() {
				@dropdown.Trigger() {
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Size:    button.SizeIcon,
						Type:    button.TypeButton,
					}) {
						@icon.EllipsisVertical(icon.Props{Class: "size-4"})
					}
				}
				@dropdown.Content(dropdown.ContentProps{
					Class:     "w-40",
					Placement: dropdown.PlacementBottomEnd,
				}) {
					@dialog.Trigger(dialog.TriggerProps{
						For: editDialogID,
					}) {
						@dropdown.Item() {
							<span class="flex items-center gap-2">
								@icon.Pencil(icon.Props{Class: "size-4"})
								Edit entry
							</span>
						}
					}
					@dialog.Trigger(dialog.TriggerProps{
						For: deleteDialogID,
					}) {
						@dropdown.Item(dropdown.ItemProps{
							Class: "text-destructive focus:text-destructive",
						}) {
							<span class="flex items-center gap-2">
								@icon.Trash(icon.Props{Class: "size-4"})
								Remove entry
							</span>
						}
					}
				}
			}
			<form
				hx-patch={ fmt.Sprintf("/htmx/movies/watched/%d", record.ID) }
				hx-target="#toast"
			>
				@dialog.Dialog(dialog.Props{
					ID: editDialogID,
				}) {
					@dialog.Content(dialog.ContentProps{
						Class: "max-w-md",
					}) {
						@dialog.Header() {
							@dialog.Title() {
								Edit Watched Entry
							}
							@dialog.Description() {
								Update the date, rating, or location for this watch.
							}
						}
						<div class="space-y-4">
							@watchedFormFields(fmt.Sprintf("edit-watched-%d", record.ID), record.Date, watchedRating, record.InTheaters)
						</div>
						@dialog.Footer() {
							@dialog.Close() {
								@button.Button(button.Props{
									Variant: button.VariantOutline,
								}) {
									Cancel
								}
							}
							@dialog.Close() {
								@button.Button(button.Props{
									Type: button.TypeSubmit,
								}) {
									Save Changes
								}
							}
						}
					}
				}
			</form>
			<form
				hx-delete={ fmt.Sprintf("/htmx/movies/watched/%d", record.ID) }
				hx-target="#toast"
			>
				@dialog.Dialog(dialog.Props{
					ID: deleteDialogID,
				}) {
					@dialog.Content(dialog.ContentProps{
						Class: "max-w-md",
					}) {
						@dialog.Header() {
							@dialog.Title() {
								Remove Watched Entry
							}
							@dialog.Description() {
								Are you sure you want to remove the watched entry from { record.Date.Format("January 2, 2006") }? This action cannot be undone.
							}
						}
						@dialog.Footer() {
							@dialog.Close() {
								@button.Button(button.Props{
									Variant: button.VariantOutline,
								}) {
									Cancel
								}
							}
							@dialog.Close() {
								@button.Button(button.Props{
									Variant: button.VariantDestructive,
									Type:    button.TypeSubmit,
								}) {
									Remove Entry
								}
							}
						}
					}
				}
			</form>
		</div>
	</div>
}

templ watchedFormFields(idPrefix string, watchedDate time.Time, watchedRating float64, inTheaters bool) {
	<div class="space-y-2">
		@form.Label(form.LabelProps{
			For: idPrefix + "-date",
		}) {
			When did you watch this movie?
		}
		@datepicker.DatePicker(datepicker.Props{
			ID:       idPrefix + "-date",
			Name:     "watched_date",
			HasError: false,
			Value:    watchedDate,
		})
	</div>
	<div class="space-y-2">
		@form.Label(form.LabelProps{
			For: idPrefix + "-rating",
		}) {
			Your rating (optional)
		}
		@rating.Rating(rating.Props{
			Value:     watchedRating,
			ReadOnly:  false,
			Precision: 0.5,
			Name:      "rating",
			ID:        idPrefix + "-rating",
		}) {
			@rating.Group() {
				for i := 1; i <= 5; i++ {
					@rating.Item(rating.ItemProps{
						Value: i,
						Style: rating.StyleStar,
					})
				}
			}
		}
	</div>
	<div class="flex items-start space-x-3">
		@checkbox.Checkbox(checkbox.Props{
			ID:      idPrefix + "-theater",
			Name:    "watched_at_theater",
			Value:   "theater",
			Checked: inTheaters,
		})
		@form.Label(form.LabelProps{
			For:   idPrefix + "-theater",
			Class: "cursor-pointer",
		}) {
			<div class="space-y-1">
				<div class="text-sm font-medium">Watched at theater</div>
				<div class="text-xs text-muted-foreground">Check if you saw this in a cinema</div>
			</div>
		}
	</div>
}

templ watchLocationIcon(inTheaters bool) {
	<div class="w-8 h-8 rounded-full bg-secondary/10 flex items-center justify-center">
		if inTheaters {
			@icon.Popcorn(icon.Props{Class: "size-[18px]"})
		} else {
			@icon.House(icon.Props{Class: "size-[18px]"})
		}
	</div>
}

// Helper functions
func formatMoney(amount int64) string {
	if amount == 0 {
		return "N/A"
	}
	switch {
	case amount >= 1000000000:
		return fmt.Sprintf("$%.1fB", float64(amount)/1000000000)
	case amount >= 1000000:
		return fmt.Sprintf("$%.1fM", float64(amount)/1000000)
	case amount >= 1000:
		return fmt.Sprintf("$%.1fK", float64(amount)/1000)
	default:
		return "$" + strconv.FormatInt(amount, 10)
	}
}

func formatNumber(num int64) string {
	str := strconv.FormatInt(num, 10)
	n := len(str)
	if n <= 3 {
		return str
	}

	var result strings.Builder
	for i, digit := range str {
		if i > 0 && (n-i)%3 == 0 {
			result.WriteString(",")
		}
		result.WriteRune(digit)
	}
	return result.String()
}

func moviePersonInitials(name string) string {
	nameParts := strings.Fields(name)
	if len(nameParts) == 0 {
		return "?"
	}

	initials := strings.ToUpper(string([]rune(nameParts[0])[0]))
	if len(nameParts) > 1 {
		initials += strings.ToUpper(string([]rune(nameParts[1])[0]))
	}

	return initials
}

func countTheaterWatches(records []models.WatchedMovieRecord) int {
	count := 0
	for _, record := range records {
		if record.InTheaters {
			count++
		}
	}
	return count
}

func getLastWatchDate(records []models.WatchedMovieRecord) time.Time {
	if len(records) == 0 {
		return time.Time{}
	}

	latest := records[0].Date
	for _, record := range records[1:] {
		if record.Date.After(latest) {
			latest = record.Date
		}
	}
	return latest
}

func calculateAverageRating(records []models.WatchedMovieRecord) string {
	var sum float64
	var count int
	for _, record := range records {
		if record.Rating != nil {
			sum += *record.Rating
			count++
		}
	}
	if count == 0 {
		return "N/A"
	}
	return fmt.Sprintf("%.1f/5", sum/float64(count))
}

func sortCast(cast []models.Cast) []models.Cast {
	slices.SortFunc(cast, func(a, b models.Cast) int {
		return cmp.Compare(a.CastOrder, b.CastOrder)
	})
	return cast
}

func sortWatchRecordsDesc(records []models.WatchedMovieRecord) []models.WatchedMovieRecord {
	slices.SortFunc(records, func(a, b models.WatchedMovieRecord) int {
		return b.Date.Compare(a.Date)
	})
	return records
}

func formatTimeAgo(t time.Time) string {
	now := time.Now()
	diff := now.Sub(t)

	switch {
	case diff < time.Hour:
		if minutes := int(diff.Minutes()); minutes < 1 {
			return "Just now"
		} else {
			return fmt.Sprintf("%dm ago", minutes)
		}
	case diff < 24*time.Hour:
		return fmt.Sprintf("%dh ago", int(diff.Hours()))
	case diff < 30*24*time.Hour:
		return fmt.Sprintf("%dd ago", int(diff.Hours()/24))
	case diff < 365*24*time.Hour:
		return fmt.Sprintf("%dmo ago", int(diff.Hours()/(24*30)))
	default:
		return fmt.Sprintf("%dy ago", int(diff.Hours()/(24*365)))
	}
}

func isKeyCrew(job string) bool {
	keyJobs := []string{
		"Director",
		"Producer",
		"Executive Producer",
		"Screenplay",
		"Writer",
		"Cinematography",
		"Music",
		"Editor",
		"Production Designer",
	}
	return slices.Contains(keyJobs, job)
}

func sortCrewByImportance(crew []models.Crew) []models.Crew {
	importanceOrder := map[string]int{
		"Director":            1,
		"Producer":            2,
		"Executive Producer":  3,
		"Screenplay":          4,
		"Writer":              5,
		"Cinematography":      6,
		"Music":               7,
		"Editor":              8,
		"Production Designer": 9,
	}

	var keyCrew []models.Crew
	for _, member := range crew {
		if isKeyCrew(member.Job) {
			keyCrew = append(keyCrew, member)
		}
	}

	slices.SortFunc(keyCrew, func(a, b models.Crew) int {
		orderA := importanceOrder[a.Job]
		orderB := importanceOrder[b.Job]

		// If both have defined order, sort by importance
		if orderA != 0 && orderB != 0 {
			return cmp.Compare(orderA, orderB)
		}
		// If only one has defined order, prioritize it
		if orderA != 0 {
			return -1
		}
		if orderB != 0 {
			return 1
		}
		// If neither has defined order, sort alphabetically
		return cmp.Compare(a.Job, b.Job)
	})

	return keyCrew
}

func getDirector(crew []models.Crew) models.Crew {
	for _, member := range crew {
		if member.Job == "Director" {
			return member
		}
	}
	return models.Crew{}
}

templ MovieLoading() {
	<div id="movie-loading" class="htmx-indicator absolute inset-0 bg-background z-30 pointer-events-none overflow-hidden">
		<div class="p-4 space-y-8">
			// Hero section mirrors rendered dimensions to avoid a layout jump.
			<div class="relative -m-4 mb-6 h-[36vh] min-h-[280px] max-h-[500px] bg-muted/50">
				<div class="flex h-full items-center p-4 sm:p-6 md:p-8 lg:p-10">
					<div class="max-w-6xl mx-auto">
						<div class="flex flex-col sm:flex-row gap-4 sm:gap-6 lg:gap-8 items-start">
							// Poster section
							<div class="hidden sm:block flex-shrink-0">
								<div class="w-24 md:w-40 lg:w-48 xl:w-52">
									<div class="aspect-[2/3] rounded-lg bg-muted shadow-lg animate-pulse"></div>
								</div>
							</div>
							// Movie info section
							<div class="flex-1 min-w-0 space-y-3 sm:space-y-4">
								@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-3/4 max-w-xl rounded-lg sm:h-10"})
								// Year and Director
								<div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
									@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-16 rounded-lg"})
									@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-32 rounded-lg"})
								</div>
								// Tagline
								<div class="max-w-2xl">
									@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-2/3 rounded-lg"})
								</div>
								// Action Buttons
								<div class="grid w-full grid-cols-1 gap-2 pt-2 sm:grid-cols-3 sm:gap-3 sm:pt-4">
									@skeleton.Skeleton(skeleton.Props{Class: "h-10 w-32 rounded-lg"})
									@skeleton.Skeleton(skeleton.Props{Class: "h-10 w-28 rounded-lg"})
									@skeleton.Skeleton(skeleton.Props{Class: "h-10 w-32 rounded-lg"})
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			// Content sections
			<div class="space-y-8 pb-5">
				// Overview
				<div>
					@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-24 mb-4 rounded-lg"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-full max-w-4xl mb-2 rounded-lg"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-3/4 max-w-4xl rounded-lg"})
				</div>
				// Genres
				<div>
					@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-16 mb-3 rounded-lg"})
					<div class="flex gap-2">
						for range 3 {
							@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-16 rounded-full"})
						}
					</div>
				</div>
				// User Activity (assuming it exists)
				<div class="border-1 rounded-lg p-3">
					@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-32 mb-4 rounded-lg"})
					<div class="space-y-6">
						// Activity stats
						<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
							for range 4 {
								<div class="text-center space-y-2">
									@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-12 mx-auto rounded-lg"})
									@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-16 mx-auto rounded-lg"})
								</div>
							}
						</div>
						@skeleton.Skeleton(skeleton.Props{Class: "h-px w-full rounded-lg"})
						// Watch history
						<div>
							@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-24 mb-3 rounded-lg"})
							<div class="space-y-2">
								for range 3 {
									@skeleton.Skeleton(skeleton.Props{Class: "h-12 w-full rounded-lg"})
								}
							</div>
						</div>
					</div>
				</div>
				// Details
				<div>
					@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-16 mb-4 rounded-lg"})
					<div class="space-y-2">
						for range 6 {
							<div class="flex">
								@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/4 rounded-lg"})
								@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/2 ml-4 rounded-lg"})
							</div>
						}
					</div>
				</div>
				// Cast
				<div>
					@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-12 mb-4 rounded-lg"})
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
						for range 9 {
							@skeleton.Skeleton(skeleton.Props{Class: "h-16 w-full rounded-lg"})
						}
					</div>
				</div>
				// Crew
				<div>
					@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-20 mb-4 rounded-lg"})
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
						for range 6 {
							<div class="space-y-1">
								@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-20 rounded-lg"})
								@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-24 rounded-lg"})
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	</div>
}
