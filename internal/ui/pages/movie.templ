package pages

import (
	"cmp"
	"fmt"
	"github.com/marcosalvi-01/gowatch/internal/models"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/moviecard"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/avatar"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/badge"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/button"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/card"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/checkbox"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/collapsible"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/datepicker"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/dialog"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/dropdown"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/form"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/icon"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/rating"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/separator"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/skeleton"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/textarea"
	"github.com/marcosalvi-01/gowatch/internal/utils"
	"net/url"
	"slices"
	"strconv"
	"strings"
	"time"
)

const movieVisibleCastLimit = 9
const movieRelatedVisibleLimit = 10
const rottenTomatoesPositiveScoreThreshold = 60.0

templ Movie(movie models.MovieDetails, watchRecords models.WatchedMovieRecords, isInWatchlist, hasLists, canRequestSeerr bool) {
	@Layout() {
		@templ.Fragment("content") {
			@movieHero(movie, isInWatchlist, hasLists, canRequestSeerr)
			@movieContent(movie, watchRecords, canRequestSeerr)
		}
	}
}

templ movieHero(movie models.MovieDetails, isInWatchlist, hasLists, canRequestSeerr bool) {
	<div class="relative -m-4 mb-6">
		if movie.Movie.BackdropPath != "" {
			@backdropHero(movie, isInWatchlist, hasLists, canRequestSeerr)
		} else {
			@fallbackHero(movie, isInWatchlist, hasLists, canRequestSeerr)
		}
		@separator.Separator()
	</div>
}

templ backdropHero(movie models.MovieDetails, isInWatchlist, hasLists, canRequestSeerr bool) {
	<div class="relative w-full min-h-[280px] overflow-hidden sm:h-[45vh] sm:max-h-[500px] md:h-[50vh] lg:h-[55vh]">
		<!-- Background Image -->
		<img
			src={ utils.TMDBImageURL("w1280", movie.Movie.BackdropPath) }
			alt={ movie.Movie.Title + " backdrop" }
			class="absolute inset-0 w-full h-full object-cover object-top"
		/>
		<!-- Gradient Overlays -->
		<div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-transparent"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
		<div class="absolute inset-0 bg-gradient-to-r from-black/40 via-transparent to-black/20 sm:from-black/60 sm:via-transparent sm:to-black/20"></div>
		<!-- Content Container - Now uses flex items-center for better centering -->
		<div class="relative flex items-start sm:absolute sm:inset-0 sm:items-center">
			<div class="w-full p-4 sm:p-6 md:p-8 lg:p-10">
				<div class="w-full">
					@heroContent(movie, true, isInWatchlist, hasLists, canRequestSeerr)
				</div>
			</div>
		</div>
	</div>
}

templ fallbackHero(movie models.MovieDetails, isInWatchlist, hasLists, canRequestSeerr bool) {
	<div class="p-4 sm:p-6 md:p-8 lg:p-10 bg-muted/20">
		<div class="w-full">
			@heroContent(movie, false, isInWatchlist, hasLists, canRequestSeerr)
		</div>
	</div>
}

templ heroContent(movie models.MovieDetails, isDark, isInWatchlist, hasLists, canRequestSeerr bool) {
	<div class="flex flex-row gap-4 sm:gap-6 lg:gap-8 items-start">
		@posterSection(movie, isDark)
		@movieInfo(movie, isDark, isInWatchlist, hasLists, canRequestSeerr)
	</div>
}

templ posterSection(movie models.MovieDetails, isDark bool) {
	if movie.Movie.PosterPath != "" {
		<div class="flex-shrink-0">
			<div class="w-20 sm:w-24 md:w-40 lg:w-48 xl:w-52">
				<div class="aspect-[2/3] rounded-lg overflow-hidden shadow-lg">
					<img
						src={ utils.TMDBImageURL("w500", movie.Movie.PosterPath) }
						alt={ movie.Movie.Title + " poster" }
						class="w-full h-full object-cover"
					/>
				</div>
			</div>
		</div>
	}
}

templ movieInfo(movie models.MovieDetails, isDark, isInWatchlist, hasLists, canRequestSeerr bool) {
	<div class="flex-1 min-w-0 space-y-3 sm:space-y-4">
		<!-- Title -->
		<div>
			<h1
				class={
					"text-xl sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-bold leading-tight",
					templ.KV("text-white drop-shadow-2xl", isDark),
					templ.KV("text-foreground", !isDark),
				}
			>
				{ movie.Movie.Title }
			</h1>
		</div>
		<!-- Year and Director -->
		<div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4">
			<p
				class={
					"text-base sm:text-lg md:text-xl font-medium",
					templ.KV("text-white/90 drop-shadow-lg", isDark),
					templ.KV("text-muted-foreground", !isDark),
				}
			>
				{ utils.FormatYear(movie.Movie.ReleaseDate) }
			</p>
			if director := getDirector(movie.Credits.Crew); director.Person.Name != "" {
				<div class="flex items-center gap-2">
					<span
						class={
							"hidden sm:block text-sm",
							templ.KV("text-white/60", isDark),
							templ.KV("text-muted-foreground", !isDark),
						}
					>
						•
					</span>
					{{ personHref := personPagePath(director.Person.ID) }}
					<p
						class={
							"text-sm sm:text-base font-medium",
							templ.KV("text-white/90 drop-shadow-lg", isDark),
							templ.KV("text-foreground", !isDark),
						}
					>
						Directed by
					</p>
					if personHref != "" {
						<p
							data-page="person"
							hx-get={ personHref }
							hx-target="#main-content"
							hx-push-url="true"
							hx-swap="scroll:#main-scroll-container:top"
							hx-indicator="#person-loading"
							class={
								"text-sm sm:text-base font-medium cursor-pointer hover:underline",
								templ.KV("text-white/90 drop-shadow-lg", isDark),
								templ.KV("text-foreground", !isDark),
							}
						>
							{ director.Person.Name }
						</p>
					} else {
						<p
							class={
								"text-sm sm:text-base font-medium",
								templ.KV("text-white/90 drop-shadow-lg", isDark),
								templ.KV("text-foreground", !isDark),
							}
						>
							{ director.Person.Name }
						</p>
					}
				</div>
			}
		</div>
		<!-- Tagline -->
		if movie.Tagline != "" {
			<div class="max-w-2xl">
				<p
					class={
						"text-sm sm:text-base md:text-lg italic",
						templ.KV("text-white/85 drop-shadow-md", isDark),
						templ.KV("text-muted-foreground", !isDark),
					}
				>
					"{ movie.Tagline }"
				</p>
			</div>
		}
		<!-- Action Buttons -->
		@actionButtons(movie.Movie.ID, hasLists, canRequestSeerr)
	</div>
}

templ actionButtons(movieID int64, hasLists, canRequestSeerr bool) {
	<div class="grid w-full grid-cols-1 gap-2 pt-2 sm:grid-cols-2 lg:grid-cols-4 sm:gap-3 sm:pt-4">
		<form
			class="w-full"
			hx-post="/htmx/movies/watched"
			hx-target="#toast"
			hx-on::after-request="this.reset()"
		>
			<input type="hidden" name="movie_id" value={ movieID }/>
			@dialog.Dialog(dialog.Props{
				ID: "default-dialog-watched",
			}) {
				@dialog.Trigger() {
					@button.Button(button.Props{Class: "w-full justify-center"}) {
						@icon.Check()
						Mark as Watched
					}
				}
				@dialog.Content(dialog.ContentProps{
					Class: "max-w-md",
				}) {
					@dialog.Header() {
						@dialog.Title() {
							Mark as Watched
						}
						@dialog.Description() {
							Mark this movie as watched by adding it to the Watched List. Click save when you're done.
						}
					}
					<div class="space-y-4">
						@watchedFormFields("add-watched", time.Now(), 0, false)
					</div>
					@dialog.Footer() {
						@dialog.Close() {
							@button.Button(button.Props{
								Variant: button.VariantOutline,
							}) {
								Cancel
							}
						}
						@dialog.Close() {
							@button.Button(button.Props{
								Type: button.TypeSubmit,
							}) {
								Add to Watched
							}
						}
					}
				}
			}
		</form>
		// TODO add hx-indicator for loading state?
		<form
			class={
				"w-full",
				templ.KV("hidden", !hasLists),
			}
			hx-post="/htmx/lists/items"
			hx-target="#toast"
			hx-on::after-request="this.reset()"
		>
			<input type="hidden" name="movie_id" value={ movieID }/>
			@dialog.Dialog(dialog.Props{
				ID: "add-movie-to-list-dialog",
			}) {
				if hasLists {
					@dialog.Trigger(dialog.TriggerProps{Class: "w-full"}) {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Class:   "w-full justify-center",
						}) {
							@icon.Plus()
							Add to List
						}
					}
				}
				@dialog.Content(dialog.ContentProps{
					Class: "max-w-md",
				}) {
					@dialog.Header() {
						@dialog.Title() {
							Add this Movie to a List
						}
						@dialog.Description() {
							Add this movie to a list to keep track of it in a specific way.
						}
					}
					<div class="space-y-4">
						<div
							hx-get="/htmx/lists/add-movie-dialog"
							hx-trigger="load, refreshLists from:body"
							hx-swap="innerHTML"
							hx-target="this"
						></div>
						<div class="space-y-2">
							@form.Label(form.LabelProps{
								For: "movie-note",
							}) {
								Add a note (optional)
							}
							@textarea.Textarea(textarea.Props{
								ID:          "movie-note",
								Name:        "note",
								Rows:        3,
								Placeholder: "Why did you add this movie to your list? Any thoughts or reminders...",
							})
						</div>
					</div>
					@dialog.Footer() {
						@dialog.Close() {
							@button.Button(button.Props{
								Variant: button.VariantOutline,
							}) {
								Cancel
							}
						}
						@dialog.Close() {
							@button.Button(button.Props{
								Type: button.TypeSubmit,
							}) {
								Add to List
							}
						}
					}
				}
			}
		</form>
		if !hasLists {
			@dialog.Trigger(dialog.TriggerProps{
				For:   "add-to-list-dialog",
				Class: "w-full",
			}) {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Class:   "w-full justify-center",
				}) {
					@icon.Plus()
					Create List
				}
			}
		}
		<div
			class="w-full [&_button]:w-full [&_button]:justify-center"
			aria-live="polite"
			hx-get={ fmt.Sprintf("/htmx/watchlist/%d", movieID) }
			hx-trigger="load, refreshWatchlist from:body"
			hx-swap="innerHTML"
			hx-target="this"
		>
			@button.Button(button.Props{Variant: button.VariantOutline, Class: "w-full justify-center text-muted-foreground", Disabled: true}) {
				@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin"})
				Checking Watchlist...
			}
		</div>
		if canRequestSeerr {
			<div
				id={ fmt.Sprintf("seerr-movie-action-%d", movieID) }
				aria-live="polite"
				hx-get={ fmt.Sprintf("/htmx/movies/%d/seerr-state", movieID) }
				hx-trigger="load, refreshSeerrMovieState from:body"
				hx-target="this"
				hx-swap="innerHTML"
			>
				@button.Button(button.Props{Variant: button.VariantOutline, Class: "w-full justify-center text-muted-foreground", Disabled: true}) {
					@icon.LoaderCircle(icon.Props{Class: "size-4 animate-spin"})
					Checking Seerr...
				}
			</div>
		}
	</div>
}

templ SeerrMovieAction(movieID int64, state, seerrURL string) {
	switch state {
		case "requestable", "retryable":
			<form
				hx-post={ fmt.Sprintf("/htmx/movies/%d/seerr-request", movieID) }
				hx-target="#toast"
				hx-disabled-elt="find button"
			>
				@button.Button(button.Props{
					Variant: button.VariantDefault,
					Class:   "w-full justify-center",
					Type:    button.TypeSubmit,
				}) {
					@icon.Send(icon.Props{Class: "size-4"})
					if state == "retryable" {
						Retry failed request
					} else {
						Request in Seerr
					}
				}
			</form>
		case "pending_approval":
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Class:   "w-full justify-center text-muted-foreground",
				Href:    seerrURL,
			}) {
				@icon.Clock3(icon.Props{Class: "size-4"})
				Pending Seerr approval
			}
		case "processing":
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Class:   "w-full justify-center border-primary/50 text-primary hover:bg-primary/10",
				Href:    seerrURL,
			}) {
				@icon.Clock3(icon.Props{Class: "size-4"})
				Requested in Seerr
			}
		case "available":
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Class:   "w-full justify-center",
				Href:    seerrURL,
			}) {
				@icon.CircleCheck(icon.Props{Class: "size-4"})
				Available in Seerr
			}
		case "disabled":
			@button.Button(button.Props{
				Variant:  button.VariantGhost,
				Class:    "w-full justify-center text-muted-foreground",
				Disabled: true,
			}) {
				@icon.Ban(icon.Props{Class: "size-4"})
				Sign in to request through Seerr
			}
		default:
			@button.Button(button.Props{
				Variant:  button.VariantOutline,
				Class:    "w-full justify-center border-yellow-500/50 text-yellow-500 hover:bg-yellow-500/10",
				Href:     seerrURL,
				Disabled: seerrURL == "",
			}) {
				@icon.TriangleAlert(icon.Props{Class: "size-4"})
				Error checking Seerr
			}
	}
}

templ movieContent(movie models.MovieDetails, watchRecords models.WatchedMovieRecords, canRequestSeerr bool) {
	<div class="w-full space-y-7 pb-5 sm:space-y-8">
		<div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)]">
			<div class="contents xl:col-start-1 xl:row-start-1 xl:block xl:min-w-0 xl:space-y-7">
				<div class="order-1 min-w-0 space-y-7">
					@movieOverview(movie)
					@MovieActivity(watchRecords.Records)
				</div>
				<div class="order-3 min-w-0 space-y-7">
					@castSection(movie.Credits.Cast)
					@crewSection(movie.Credits.Crew)
				</div>
			</div>
			<aside class="order-2 space-y-6 xl:col-start-2 xl:row-start-1 xl:self-start">
				if movie.Movie.VoteAverage > 0 || canRequestSeerr {
					@MovieRatings(movie.Movie, canRequestSeerr)
				}
				@movieMetadata(movie)
				@movieTrailerSection(movie.RelatedVideos)
			</aside>
		</div>
		@MovieRelatedLoading("movie-recommendations", "Recommended Movies", "recommendations", movie.Movie.ID)
		@MovieRelatedLoading("movie-similar", "Similar Movies", "similar", movie.Movie.ID)
	</div>
}

templ movieOverview(movie models.MovieDetails) {
	if movie.Movie.Overview != "" || len(movie.Genres) > 0 {
		<section class="space-y-4">
			@movieSectionHeader("Overview", icon.FileText)
			@card.Card(card.Props{Class: "bg-card/40"}) {
				@card.Content(card.ContentProps{Class: "space-y-4 p-5 sm:p-6"}) {
					if movie.Movie.Overview != "" {
						<p class="text-sm leading-relaxed text-muted-foreground sm:text-base">{ movie.Movie.Overview }</p>
					}
					if len(movie.Genres) > 0 {
						<div class="flex flex-wrap gap-2">
							for _, genre := range movie.Genres {
								@badge.Badge(badge.Props{Variant: "primary"}) {
									{ genre.Name }
								}
							}
						</div>
					}
				}
			}
		</section>
	}
}

templ movieTrailerSection(videos []models.RelatedVideo) {
	{{ trailers := movieTrailerLinks(videos) }}
	if len(trailers) > 0 {
		<section class="space-y-4">
			@movieSectionHeader("Trailers", icon.Film)
			<div class="grid grid-cols-1 gap-3">
				for _, trailer := range trailers {
					<a
						href={ templ.URL(trailer.URL) }
						target="_blank"
						rel="noopener noreferrer"
						class="flex min-h-20 items-center gap-4 rounded-lg border bg-card/40 p-4 transition-colors hover:bg-muted/50"
					>
						@icon.CirclePlay(icon.Props{Class: "size-8 shrink-0 text-primary"})
						<span class="min-w-0">
							<span class="block truncate font-medium">{ trailer.Name }</span>
							<span class="block text-sm text-muted-foreground">{ trailer.Type } · YouTube</span>
						</span>
						@icon.ExternalLink(icon.Props{Class: "ml-auto size-4 shrink-0 text-muted-foreground"})
					</a>
				}
			</div>
		</section>
	}
}

templ MovieRatings(movie models.Movie, canLoadExternal bool) {
	<section id="movie-ratings" class="space-y-4">
		@movieSectionHeader("Ratings", icon.Star)
		@card.Card(card.Props{Class: "bg-card/40"}) {
			@card.Content(card.ContentProps{Class: "space-y-4 p-5"}) {
				if movie.VoteAverage > 0 {
					@ratingEntry("TMDB", float64(movie.VoteAverage), "TMDB", fmt.Sprintf("%.1f/10", movie.VoteAverage), fmt.Sprintf("%s votes", formatNumber(movie.VoteCount)), "")
				}
				if canLoadExternal {
					<div
						class="space-y-4"
						hx-get={ fmt.Sprintf("/htmx/movies/%d/ratings", movie.ID) }
						hx-trigger="load"
						hx-target="this"
						hx-swap="innerHTML"
						aria-live="polite"
					>
						@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-full rounded"})
						@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-full rounded"})
						@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-full rounded"})
					</div>
				} else if movie.VoteAverage <= 0 {
					<p class="text-sm text-muted-foreground">No ratings available.</p>
				}
			}
		}
	</section>
}

templ MovieExternalRatings(ratings *models.MovieRatings, failed bool) {
	{{ hasRating := false }}
	<div class="space-y-4">
		if ratings != nil && ratings.IMDb != nil && ratings.IMDb.Score != nil {
			{{ hasRating = true }}
			@ratingEntry("IMDb", *ratings.IMDb.Score, "IMDb", fmt.Sprintf("%.1f/10", *ratings.IMDb.Score), "", ratings.IMDb.URL)
		}
		if ratings != nil && ratings.RottenTomatoes != nil {
			if ratings.RottenTomatoes.CriticsScore != nil {
				{{ hasRating = true }}
				@ratingEntry("RT Critics", *ratings.RottenTomatoes.CriticsScore, "Tomatometer", fmt.Sprintf("%.0f%%", *ratings.RottenTomatoes.CriticsScore), ratings.RottenTomatoes.CriticsRating, ratings.RottenTomatoes.URL)
			}
			if ratings.RottenTomatoes.AudienceScore != nil {
				{{ hasRating = true }}
				@ratingEntry("RT Audience", *ratings.RottenTomatoes.AudienceScore, "Popcornmeter", fmt.Sprintf("%.0f%%", *ratings.RottenTomatoes.AudienceScore), ratings.RottenTomatoes.AudienceRating, ratings.RottenTomatoes.URL)
			}
		}
		if !hasRating {
			if failed {
				<p class="text-sm text-muted-foreground">External ratings unavailable.</p>
			} else {
				<p class="text-sm text-muted-foreground">No external ratings listed.</p>
			}
		}
	</div>
}

templ ratingEntry(source string, value float64, label, score, detail, href string) {
	{{ externalURL := safeRatingURL(href) }}
	<div class="flex items-center justify-between gap-3">
		<div class="flex min-w-0 items-center gap-3">
			@ratingSourceLogo(source, value)
			<div class="min-w-0">
				<div class="truncate text-sm font-medium leading-5">{ label }</div>
				<div class="h-4 truncate text-xs leading-4 text-muted-foreground">{ detail }</div>
			</div>
		</div>
		<div class="shrink-0 text-lg font-semibold">
			if externalURL != "" {
				<a href={ externalURL } target="_blank" rel="noopener noreferrer" class="hover:underline">{ score }</a>
			} else {
				{ score }
			}
		</div>
	</div>
}

templ ratingSourceLogo(source string, value float64) {
	{{ src, alt, heightClass := ratingSourceAsset(source, value) }}
	<div class="flex h-8 w-12 shrink-0 items-center justify-center">
		if src != "" {
			<img src={ src } alt={ alt } class={ "w-auto max-w-full object-contain " + heightClass }/>
		}
	</div>
}

templ MovieRelatedLoading(sectionID, title, relationship string, movieID int64) {
	<section
		id={ sectionID }
		class="space-y-4"
		hx-get={ fmt.Sprintf("/htmx/movies/%d/%s", movieID, relationship) }
		hx-trigger="load"
		hx-target="this"
		hx-swap="outerHTML"
	>
		@movieSectionHeader(title, icon.Film)
		<div class="flex w-full gap-4 overflow-x-auto snap-x snap-mandatory pb-2">
			for range 5 {
				<div class="w-[110px] shrink-0 snap-start sm:w-[140px] md:w-[160px]">
					@skeleton.Skeleton(skeleton.Props{Class: "aspect-[2/3] w-full rounded-lg"})
				</div>
			}
		</div>
	</section>
}

templ MovieRelatedSection(sectionID, title, errorMessage string, movies []models.SearchResult, failed bool) {
	if failed {
		<section id={ sectionID } class="space-y-4" aria-live="polite">
			@movieSectionHeader(title, icon.Film)
			<p class="rounded-lg border border-dashed p-5 text-sm text-muted-foreground">{ errorMessage }</p>
		</section>
	} else if len(movies) > 0 {
		<section id={ sectionID } class="space-y-4">
			@movieSectionHeader(title, icon.Film)
			<div class="flex w-full gap-4 overflow-x-auto snap-x snap-mandatory pb-3">
				for i, movie := range movies {
					if i >= movieRelatedVisibleLimit {
						{{ break }}
					}
					@moviecard.MovieCard(moviecard.Props{
						Title:        movie.Title,
						PosterPath:   movie.ImagePath,
						Href:         "/movie/" + strconv.FormatInt(movie.ID, 10),
						IndicatorID:  "#movie-loading",
						Hoverable:    true,
						SeerrMovieID: movie.ID,
						Class:        "w-[110px] shrink-0 snap-start border-0 group sm:w-[140px] md:w-[160px]",
					}) {
						<h3 class="mb-1 line-clamp-2 text-xs font-bold leading-tight md:text-sm">{ movie.Title }</h3>
						<div class="flex items-center justify-between gap-2">
							<p class="text-xs opacity-90">{ movie.SecondaryText }</p>
							if movie.VoteAverage > 0 {
								<div class="flex items-center">
									@icon.Star(icon.Props{Class: "size-3 fill-[orange] stroke-[orange]"})
									<span class="ml-1 text-xs">{ fmt.Sprintf("%.1f", movie.VoteAverage) }</span>
								</div>
							}
						</div>
					}
				}
			</div>
		</section>
	}
}

templ movieSectionHeader(title string, iconFn func(...icon.Props) templ.Component) {
	<h2 class="flex items-center gap-2 text-xl font-semibold">
		@iconFn(icon.Props{Class: "size-5 text-primary"})
		{ title }
	</h2>
}

templ MovieActivity(records []models.WatchedMovieRecord) {
	<section id="movie-activity-section" class="space-y-4">
		@movieSectionHeader("Your Activity", icon.Activity)
		@card.Card(card.Props{Class: "bg-card/40"}) {
			if len(records) == 0 {
				@card.Content(card.ContentProps{Class: "flex items-center gap-3 p-4"}) {
					@icon.Film(icon.Props{Class: "size-5 shrink-0 text-muted-foreground"})
					<p class="text-sm text-muted-foreground">Not watched yet</p>
				}
			} else {
				@card.Content(card.ContentProps{Class: "space-y-4 p-4"}) {
					@activityStats(records)
					<details class="group border-t pt-3">
						<summary class="cursor-pointer text-sm font-medium hover:text-primary">
							Watch history ({ len(records) })
						</summary>
						<div class="mt-3 max-h-64 space-y-2 overflow-auto">
							for _, record := range sortWatchRecordsDesc(records) {
								@watchHistoryItem(record)
							}
						</div>
					</details>
				}
			}
		}
	</section>
}

templ movieMetadata(movie models.MovieDetails) {
	{{ homepageURL := safeRatingURL(movie.Homepage) }}
	{{ imdbURL := movieIMDbURL(movie.IMDbID) }}
	if hasMovieFacts(movie) || homepageURL != "" || imdbURL != "" {
		<section class="space-y-4">
			@movieSectionHeader("At a Glance", icon.FileText)
			@card.Card(card.Props{Class: "bg-card/40"}) {
				@card.Content(card.ContentProps{Class: "p-5"}) {
					<dl class="divide-y divide-border text-sm">
						if movie.Movie.ReleaseDate != nil {
							@movieFact("Release", utils.FormatLongDate(movie.Movie.ReleaseDate))
						}
						if movie.Runtime > 0 {
							@movieFact("Runtime", fmt.Sprintf("%s (%d min)", formatRuntimeMinutes(int64(movie.Runtime)), movie.Runtime))
						}
						if movie.Movie.OriginalLanguage != "" {
							@movieFact("Language", strings.ToUpper(movie.Movie.OriginalLanguage))
						}
						if movie.Status != "" {
							@movieFact("Status", movie.Status)
						}
						if len(movie.ProductionCompanies) > 0 {
							@movieFact("Studios", productionCompanyNames(movie.ProductionCompanies))
						}
						if len(movie.ProductionCountries) > 0 {
							@movieFact("Countries", productionCountryNames(movie.ProductionCountries))
						}
						if movie.Budget > 0 {
							@movieFact("Budget", formatMoney(movie.Budget))
						}
						if movie.Revenue > 0 {
							@movieFact("Revenue", formatMoney(movie.Revenue))
						}
					</dl>
					if homepageURL != "" || imdbURL != "" {
						<div class="flex flex-wrap gap-x-4 gap-y-2 pt-4 text-sm">
							if homepageURL != "" {
								<a href={ homepageURL } target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-primary hover:underline">
									Official site
									@icon.ExternalLink(icon.Props{Class: "size-3.5"})
								</a>
							}
							if imdbURL != "" {
								<a href={ imdbURL } target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-primary hover:underline">
									IMDb
									@icon.ExternalLink(icon.Props{Class: "size-3.5"})
								</a>
							}
						</div>
					}
				}
			}
		</section>
	}
}

templ movieFact(label, value string) {
	<div class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-3 py-2.5">
		<dt class="text-muted-foreground">{ label }</dt>
		<dd class="min-w-0 break-words font-medium">{ value }</dd>
	</div>
}

templ castSection(cast []models.Cast) {
	if len(cast) > 0 {
		{{ sortedCast := sortCast(cast) }}
		<div class="space-y-4">
			@movieSectionHeader("Cast", icon.Users)
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				for i, member := range sortedCast {
					if i >= movieVisibleCastLimit {
						{{ break }}
					}
					@castMemberCard(member)
				}
			</div>
			if len(sortedCast) > movieVisibleCastLimit {
				@collapsible.Collapsible(collapsible.Props{Class: "group/collapsible mt-4"}) {
					@collapsible.Content(collapsible.ContentProps{Class: "mb-4"}) {
						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-1">
							for i, member := range sortedCast {
								if i < movieVisibleCastLimit {
