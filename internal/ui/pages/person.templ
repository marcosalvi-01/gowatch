package pages

import (
	"fmt"
	"github.com/marcosalvi-01/gowatch/internal/models"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/moviecard"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/badge"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/card"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/collapsible"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/icon"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/separator"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/selectbox"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/skeleton"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/table"
	"github.com/marcosalvi-01/gowatch/internal/utils"
	"math/rand/v2"
	"sort"
	"strconv"
	"strings"
	"time"
)

const (
	personBiographyFallbackText = "No biography available yet."
	personBiographyPreviewLimit = 400
	personUnknownDetailValue    = "N/A"
	personMovieMediaType        = "movie"
	personFilmographyPageSize  = 24
	personFilmographyMaxCredits = 240
	personFilmographyMinimumVotes = 50
	personFeaturedBackdropLimit = 20
	personKnownForVisibleLimit  = 3
)

const (
	personFilmographyTypeAll    = "all"
	personFilmographyTypeActing = "acting"
	personFilmographyTypeCrew   = "crew"
	personFilmographyRoleAll    = "all"
	personFilmographyMediaAll   = "all"
	personFilmographyQualityPopular = "popular"
	personFilmographyQualityAll     = "all"
	personFilmographySortFeatured = "featured"
	personFilmographySortNewest   = "newest"
	personFilmographySortOldest   = "oldest"
	personFilmographySortRating   = "rating"
	personFilmographySortPopular  = "popular"
)

templ Person(person models.PersonDetailsPage, activity models.PersonWatchActivity, state PersonFilmographyState) {
	{{ prepared := preparePersonFilmography(person.ActingCredits, person.CrewCredits, state) }}
	@Layout() {
		@templ.Fragment("content") {
			@personHero(person, personBackdropPath(prepared.Credits))
			<div class="space-y-7 pb-5 sm:space-y-8">
				@personDetailsSection(person)
				@personWatchActivitySection(activity)
				<div id="person-filmography">
					@personFilmographyPrepared(person, state, prepared)
				</div>
			</div>
		}
	}
}

templ PersonFilmography(person models.PersonDetailsPage, state PersonFilmographyState) {
	{{ prepared := preparePersonFilmography(person.ActingCredits, person.CrewCredits, state) }}
	@personFilmographyPrepared(person, state, prepared)
}

templ personHero(person models.PersonDetailsPage, backdropPath string) {
	<div class="relative -m-4 mb-6">
		if backdropPath != "" {
			@personBackdropHero(person, backdropPath)
		} else {
			@personFallbackHero(person)
		}
		@separator.Separator()
	</div>
}

templ personBackdropHero(person models.PersonDetailsPage, backdropPath string) {
	<div class="relative w-full h-[40vh] min-h-[350px] max-h-[500px] sm:h-[45vh] md:h-[50vh] lg:h-[55vh] overflow-hidden">
		<img
			src={ utils.TMDBImageURL("w1280", backdropPath) }
			alt={ person.Name + " backdrop" }
			class="absolute inset-0 w-full h-full object-cover object-top"
		/>
		<div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/30 to-transparent"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"></div>
		<div class="absolute inset-0 bg-gradient-to-r from-black/40 via-transparent to-black/20 sm:from-black/60 sm:via-transparent sm:to-black/20"></div>
		<div class="absolute inset-0 flex items-center">
			<div class="w-full p-4 sm:p-6 md:p-8 lg:p-10">
				<div class="max-w-6xl mx-auto w-full">
					@personHeroContent(person, true)
				</div>
			</div>
		</div>
	</div>
}

templ personFallbackHero(person models.PersonDetailsPage) {
	<div class="p-4 sm:p-6 md:p-8 lg:p-10 bg-muted/20">
		<div class="max-w-6xl mx-auto">
			@personHeroContent(person, false)
		</div>
	</div>
}

templ personHeroContent(person models.PersonDetailsPage, isDark bool) {
	<div class="flex flex-row gap-4 sm:gap-6 lg:gap-8 items-start">
		@personHeroProfile(person)
		@personHeroInfo(person, isDark)
	</div>
}

templ personHeroProfile(person models.PersonDetailsPage) {
	<div class="w-20 sm:w-24 md:w-40 lg:w-48 xl:w-52 flex-shrink-0">
		<div class="aspect-[2/3] rounded-lg overflow-hidden shadow-lg">
			if person.ProfilePath != "" {
				<img
					src={ utils.TMDBImageURL("w780", person.ProfilePath) }
					alt={ person.Name + " profile" }
					class="h-full w-full object-cover"
				/>
			} else {
				<div class="h-full w-full flex flex-col items-center justify-center gap-3 text-muted-foreground dark:text-white/80">
					<div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-black/5 dark:bg-white/10">
					@icon.User(icon.Props{Class: "size-[30px]"})
					</div>
					<div class="text-lg font-semibold tracking-wide">{ personInitials(person.Name) }</div>
				</div>
			}
		</div>
	</div>
}

templ personHeroInfo(person models.PersonDetailsPage, isDark bool) {
	<div class="flex-1 min-w-0 space-y-3 sm:space-y-4">
		<h1
			class={
				"text-xl sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-bold leading-tight",
				templ.KV("text-white drop-shadow-2xl", isDark),
				templ.KV("text-foreground", !isDark),
			}
		>
			{ person.Name }
		</h1>
		<p
			class={
				"text-sm sm:text-base md:text-lg max-w-3xl",
				templ.KV("text-white/85 drop-shadow-md", isDark),
				templ.KV("text-muted-foreground", !isDark),
			}
		>
			{ personHeroSubtitle(person) }
		</p>
		if len(person.KnownFor) > 0 {
			<div class="space-y-1.5 sm:space-y-2">
				<p class="text-[11px] sm:text-xs font-semibold uppercase tracking-wide text-white">
					Known For
				</p>
				<div class="flex flex-wrap gap-1.5 sm:gap-2">
					for i, credit := range person.KnownFor {
						if i >= personKnownForVisibleLimit {
							{{ break }}
						}
						@personKnownForCredit(credit)
					}
				</div>
			</div>
		}
	</div>
}

templ personKnownForCredit(credit models.PersonCredit) {
	{{ href := personCreditHref(credit) }}
	if href != "" {
		<span
			data-page="movie"
			hx-get={ href }
			hx-target="#main-content"
			hx-push-url="true"
			hx-swap="scroll:#main-scroll-container:top"
			hx-indicator="#movie-loading"
			class="cursor-pointer"
		>
			@personKnownForBadge(credit.Title)
		</span>
	} else {
		@personKnownForBadge(credit.Title)
	}
}

templ personKnownForBadge(title string) {
	@badge.Badge(badge.Props{
		Variant: badge.VariantSecondary,
		Class:   "rounded-full whitespace-normal",
	}) {
		{ title }
	}
}

templ personSectionHeader(title string, iconFn func(...icon.Props) templ.Component) {
	<h2 class="flex items-center gap-2 text-xl font-semibold">
		@iconFn(icon.Props{Class: "size-5 text-primary"})
		{ title }
	</h2>
}

templ personDetailsSection(person models.PersonDetailsPage) {
	<div class="space-y-4">
		@personSectionHeader("Person Details", icon.FileText)
		@card.Card(card.Props{Class: "bg-card/40"}) {
			@card.Content(card.ContentProps{Class: "space-y-6 p-5 sm:p-6"}) {
				<div class="space-y-3">
					<h3 class="text-base font-semibold">Biography</h3>
					@personBiography(person.Biography)
				</div>
				@separator.Separator()
				<div class="space-y-3">
					<h3 class="text-base font-semibold">Personal Information</h3>
					@table.Table() {
				@table.Body() {
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							Known For
						}
						@table.Cell() {
							{ personValueOrFallback(person.KnownForDepartment) }
						}
					}
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							Born
						}
						@table.Cell() {
							{ utils.FormatLongDate(person.Birthday) }
						}
					}
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							Died
						}
						@table.Cell() {
							{ utils.FormatLongDate(person.Deathday) }
						}
					}
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							Age
						}
						@table.Cell() {
							{ personAgeText(person.Birthday, person.Deathday) }
						}
					}
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							Place of Birth
						}
						@table.Cell() {
							{ personValueOrFallback(person.PlaceOfBirth) }
						}
					}
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							Popularity
						}
						@table.Cell() {
							{ fmt.Sprintf("%.1f", person.Popularity) }
						}
					}
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							Acting Credits
						}
						@table.Cell() {
							{ strconv.Itoa(len(person.ActingCredits)) }
						}
					}
					@table.Row() {
						@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
							Crew Credits
						}
						@table.Cell() {
							{ strconv.Itoa(len(person.CrewCredits)) }
						}
					}
					if person.IMDbID != "" {
						@table.Row() {
							@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
								IMDB
							}
							@table.Cell() {
								<a href={ templ.URL("https://www.imdb.com/name/" + person.IMDbID) } target="_blank" class="text-primary hover:underline inline-flex items-center gap-1">
									View on IMDB
									@icon.ExternalLink(icon.Props{Class: "size-[14px]"})
								</a>
							}
						}
					}
					if person.Homepage != "" {
						@table.Row() {
							@table.Cell(table.CellProps{Class: "font-medium text-muted-foreground w-1/3"}) {
								Homepage
							}
							@table.Cell() {
								<a href={ templ.URL(person.Homepage) } target="_blank" class="text-primary hover:underline inline-flex items-center gap-1">
									Visit homepage
									@icon.ExternalLink(icon.Props{Class: "size-[14px]"})
								</a>
							}
						}
					}
					}
					}
				</div>
			}
		}
	</div>
}

templ personBiography(biography string) {
	{{ preview, isTruncated := personBiographyPreview(biography) }}
	if !isTruncated {
		<p class="max-w-4xl text-sm leading-relaxed text-muted-foreground sm:text-base">{ preview }</p>
	} else {
		@collapsible.Collapsible(collapsible.Props{Class: "group/collapsible space-y-2"}) {
			<p class="max-w-4xl text-sm leading-relaxed text-muted-foreground sm:text-base group-data-[tui-collapsible-state=open]/collapsible:hidden">{ preview }</p>
			@collapsible.Content() {
				<p class="max-w-4xl text-sm leading-relaxed text-muted-foreground sm:text-base">{ personBiographyText(biography) }</p>
			}
			@collapsible.Trigger(collapsible.TriggerProps{
				Class: "inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-primary hover:underline",
				Attributes: templ.Attributes{
					"role":       "button",
					"tabindex":   "0",
					"aria-label": "Toggle full biography",
				},
			}) {
				<span class="group-data-[tui-collapsible-state=open]/collapsible:hidden">Read full biography</span>
				<span class="hidden group-data-[tui-collapsible-state=open]/collapsible:inline">Show less</span>
				@icon.ChevronRight(icon.Props{Class: "size-4 transition-transform group-data-[tui-collapsible-state=open]/collapsible:rotate-90"})
			}
		}
	}
}

templ personWatchActivitySection(activity models.PersonWatchActivity) {
	<div class="space-y-4">
		@personSectionHeader("Your Activity", icon.Activity)
		@card.Card(card.Props{Class: "bg-card/40"}) {
			if len(activity.Movies) > 0 {
				@card.Content(card.ContentProps{Class: "space-y-6 p-5 sm:p-6"}) {
					@personWatchActivityStats(activity)
					if len(activity.Ranks) > 0 {
						@separator.Separator()
						@personWatchRankings(activity.Ranks)
					}
					@separator.Separator()
					@personWatchHistory(activity.Movies)
				}
			} else {
				@card.Content(card.ContentProps{Class: "flex items-center gap-3 p-5 sm:p-6"}) {
					@icon.Film(icon.Props{Class: "size-5 text-muted-foreground"})
					<div>
						<p class="font-medium">No activity yet</p>
						<p class="text-sm text-muted-foreground">Watch movies featuring this person to see your history here.</p>
					</div>
				}
			}
		}
	</div>
}

templ personWatchActivityStats(activity models.PersonWatchActivity) {
	<div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
		@personActivityStat("Times Watched", fmt.Sprintf("%d", activity.TotalWatchCount))
		@personActivityStat("Movies Watched", fmt.Sprintf("%d", len(activity.Movies)))
		@personActivityStat("Last Watched", personLatestWatchDateText(activity.Movies))
	</div>
}

templ personActivityStat(label, value string) {
	<div class="flex min-h-20 flex-col justify-center rounded-lg bg-muted/50 p-3 text-center">
		<div class="text-2xl font-bold text-primary">{ value }</div>
		<div class="text-xs text-muted-foreground">{ label }</div>
	</div>
}

templ personWatchRankings(ranks []models.PersonWatchRank) {
	<div class="space-y-3">
		<h3 class="text-sm font-semibold">Your Rankings</h3>
		<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
			for _, rank := range ranks {
				@personWatchRankCard(rank)
			}
		</div>
	</div>
}

templ personWatchRankCard(rank models.PersonWatchRank) {
	<div class="w-full rounded-lg border border-border/60 bg-muted/15 p-3 sm:w-[20rem]">
		<p class="mb-2 text-sm font-semibold">{ rank.Label }</p>
		<div class="grid grid-cols-2 gap-3">
			<div>
				<p class="text-[11px] uppercase tracking-wide text-muted-foreground">Most watched</p>
				<p class="mt-1 text-xl font-bold text-primary">{ personRankValue(rank.MostWatchedRank) }</p>
			</div>
			<div>
				<p class="text-[11px] uppercase tracking-wide text-muted-foreground">Favorite</p>
				if rank.FavoriteRank != nil {
					<p class="mt-1 text-xl font-bold text-primary">{ fmt.Sprintf("#%d", *rank.FavoriteRank) }</p>
					<p class="text-xs text-muted-foreground">{ fmt.Sprintf("%.1f avg · %d rated", rank.FavoriteAverageRating, rank.FavoriteRatedMovieCount) }</p>
				} else {
					<p class="mt-1 text-sm font-medium text-muted-foreground">Not enough ratings</p>
				}
			</div>
		</div>
	</div>
}

func personRankValue(rank *int64) string {
	if rank == nil {
		return "N/A"
	}

	return fmt.Sprintf("#%d", *rank)
}

templ personWatchHistory(movies []models.PersonWatchedMovie) {
	<div>
		<h3 class="text-sm font-medium mb-3">Movies Watched</h3>
		<div class="space-y-2 max-h-64 overflow-y-auto">
			for _, movie := range movies {
				@personWatchedMovieItem(movie)
			}
		</div>
	</div>
}

templ personWatchedMovieItem(movie models.PersonWatchedMovie) {
	<div
		data-page="movie"
		hx-get={ "/movie/" + strconv.FormatInt(movie.ID, 10) }
		hx-target="#main-content"
		hx-push-url="true"
		hx-swap="scroll:#main-scroll-container:top"
		hx-indicator="#movie-loading"
		class="flex items-center justify-between gap-3 rounded-lg bg-muted/50 px-3 py-2 cursor-pointer hover:bg-muted/70 transition-colors"
	>
		<div class="flex min-w-0 items-center gap-3">
			@personCreditPoster(movie.PosterPath, movie.Title)
			<div class="min-w-0">
				<div class="text-sm font-medium line-clamp-1">{ movie.Title }</div>
				if len(movie.Roles) > 0 {
					<div class="text-xs text-muted-foreground line-clamp-1">{ personWatchRolesText(movie.Roles) }</div>
				}
			</div>
		</div>
		<div class="text-xs text-muted-foreground whitespace-nowrap">{ personWatchCountText(movie.WatchCount) }</div>
	</div>
}

type personFilmographyCredit struct {
	Credit    models.PersonCredit
	RoleKeys  []string
	RoleNames []string
	IsActing  bool
	IsCrew    bool
}

type personFilmographyRoleOption struct {
	Key   string
	Label string
}

type personFilmographyYearGroup struct {
	Label   string
	Credits []personFilmographyCredit
}

templ personFilmography(person models.PersonDetailsPage, state PersonFilmographyState) {
	{{ prepared := preparePersonFilmography(person.ActingCredits, person.CrewCredits, state) }}
	@personFilmographyPrepared(person, state, prepared)
}

templ personFilmographyPrepared(person models.PersonDetailsPage, state PersonFilmographyState, prepared personPreparedFilmography) {
	<div class="space-y-4">
		@personSectionHeader("Filmography", icon.Film)
		@personFilmographyControls(person.ID, prepared.State, prepared.Roles, prepared.LoadedCount, prepared.Total)
		if prepared.Total == 0 {
			<div class="rounded-lg border border-dashed p-8 text-center">
				<p class="font-medium">No matching credits</p>
				<p class="mt-1 text-sm text-muted-foreground">Try changing one of the filmography filters.</p>
			</div>
		} else if prepared.State.Sort == personFilmographySortNewest || prepared.State.Sort == personFilmographySortOldest {
			@personFilmographyTimeline(prepared.Groups)
			if prepared.HasMore {
				@personFilmographyMoreLink(person.ID, prepared.State, prepared.State.Page+1, false)
			}
		} else {
			<div class="grid grid-cols-3 gap-3 sm:grid-cols-4 sm:gap-4 md:flex md:flex-wrap md:gap-6">
				for _, credit := range prepared.Visible {
					@personFilmographyCard(credit)
				}
				if prepared.HasMore {
					@personFilmographyMoreLink(person.ID, prepared.State, prepared.State.Page+1, true)
				}
			</div>
		}
	</div>
}

templ PersonFilmographyPage(person models.PersonDetailsPage, state PersonFilmographyState) {
	{{ prepared := preparePersonFilmography(person.ActingCredits, person.CrewCredits, state) }}
	<div class="contents">
		@personFilmographyCount(prepared.LoadedCount, prepared.Total, true)
		if prepared.State.Sort == personFilmographySortNewest || prepared.State.Sort == personFilmographySortOldest {
			@personFilmographyTimeline(prepared.Groups)
		} else {
			for _, credit := range prepared.Visible {
				@personFilmographyCard(credit)
			}
		}
		if prepared.HasMore {
			@personFilmographyMoreLink(person.ID, prepared.State, prepared.State.Page+1, prepared.State.Sort != personFilmographySortNewest && prepared.State.Sort != personFilmographySortOldest)
		}
	</div>
}

templ personFilmographyControls(personID int64, state PersonFilmographyState, roles []personFilmographyRoleOption, loadedCount, total int) {
	<form
		class="flex flex-wrap items-end gap-3 rounded-lg border bg-card/40 p-3 sm:p-4"
		hx-get={ personPagePath(personID) }
		hx-target="#person-filmography"
		hx-push-url="true"
		hx-swap="innerHTML"
		hx-trigger="change"
	>
		@personFilmographySelect("credit_type", "Credit type", state.Type, []personFilmographyRoleOption{{Key: personFilmographyTypeAll, Label: "All credits"}, {Key: personFilmographyTypeActing, Label: "Acting"}, {Key: personFilmographyTypeCrew, Label: "Crew"}})
		@personFilmographySelect("role", "Role", state.Role, append([]personFilmographyRoleOption{{Key: personFilmographyRoleAll, Label: "All roles"}}, roles...))
		@personFilmographySelect("media", "Media", state.Media, []personFilmographyRoleOption{{Key: personFilmographyMediaAll, Label: "Movies and TV"}, {Key: personMovieMediaType, Label: "Movies"}, {Key: "tv", Label: "TV"}})
		@personFilmographySelect("quality", "Quality", state.Quality, []personFilmographyRoleOption{{Key: personFilmographyQualityPopular, Label: "Popular credits"}, {Key: personFilmographyQualityAll, Label: "All credits"}})
		@personFilmographySelect("sort", "Sort", state.Sort, []personFilmographyRoleOption{{Key: personFilmographySortFeatured, Label: "Featured"}, {Key: personFilmographySortNewest, Label: "Newest first"}, {Key: personFilmographySortOldest, Label: "Oldest first"}, {Key: personFilmographySortRating, Label: "Highest rated"}, {Key: personFilmographySortPopular, Label: "Most popular"}})
		@personFilmographyCount(loadedCount, total, false)
	</form>
}

templ personFilmographySelect(name, label, selected string, options []personFilmographyRoleOption) {
	<div class="min-w-[9rem] flex-1 space-y-1 sm:flex-none">
		<p class="text-xs font-medium text-muted-foreground">{ label }</p>
		@selectbox.SelectBox(selectbox.Props{Class: "w-full sm:w-40"}) {
			@selectbox.Trigger(selectbox.TriggerProps{Name: name, Class: "w-full"}) {
				for _, option := range options {
					if option.Key == selected {
						@selectbox.Value(selectbox.ValueProps{Placeholder: option.Label})
					}
				}
			}
			@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
				for _, option := range options {
					@selectbox.Item(selectbox.ItemProps{Value: option.Key, Selected: option.Key == selected}) {
						{ option.Label }
					}
				}
			}
		}
	</div>
}

templ personFilmographyTimeline(groups []personFilmographyYearGroup) {
	<div class="space-y-6">
		for _, group := range groups {
			<div class="space-y-3">
				<div class="flex items-center gap-3">
					<h3 class="text-lg font-semibold">{ group.Label }</h3>
					<div class="h-px flex-1 bg-border"></div>
				</div>
				<div class="grid grid-cols-3 gap-3 sm:grid-cols-4 sm:gap-4 md:flex md:flex-wrap md:gap-6">
					for _, credit := range group.Credits {
						@personFilmographyCard(credit)
					}
				</div>
			</div>
		}
	</div>
}

templ personFilmographyCard(credit personFilmographyCredit) {
		@moviecard.MovieCard(moviecard.Props{
			Title:              credit.Credit.Title,
			PosterPath:         credit.Credit.PosterPath,
			Hoverable:          true,
			Href:               personCreditHref(credit.Credit),
			IndicatorID:        "#movie-loading",
			Class:              "w-full border-0 group md:w-[160px]",
			TopStaticComponent: personCreditTypeChip(credit.Credit.MediaType),
	}) {
		<h3 class="mb-1 text-xs font-bold leading-tight md:text-sm">{ credit.Credit.Title }</h3>
		<p class="line-clamp-2 text-xs opacity-90">{ strings.Join(credit.RoleNames, " • ") }</p>
		<div class="mt-1 flex items-center justify-between gap-2">
			<p class="text-xs opacity-90">{ personCreditDateText(credit.Credit.ReleaseDate) }</p>
			if credit.Credit.VoteAverage > 0 {
				<div class="flex items-center">
					@icon.Star(icon.Props{Class: "size-3 fill-[orange] stroke-[orange]"})
					<span class="ml-1 text-xs">{ fmt.Sprintf("%.1f", credit.Credit.VoteAverage) }</span>
				</div>
			}
		</div>
	}
}

templ personCreditTypeChip(mediaType string) {
	@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide shadow-sm"}) {
		if mediaType == personMovieMediaType {
			@icon.Film()
		} else {
			@icon.Tv()
		}
	}
}


templ personFilmographyMoreLink(personID int64, state PersonFilmographyState, page int, isGrid bool) {
	<div
		id={ fmt.Sprintf("person-filmography-more-%d", page) }
		class={
			"grid grid-cols-3 gap-3 pt-4 sm:grid-cols-4 sm:gap-4 md:flex md:flex-wrap md:gap-6",
			templ.KV("col-span-full md:basis-full", isGrid),
		}
		hx-get={ personFilmographyPath(personID, state, page) }
		hx-trigger="intersect once root:#main-scroll-container threshold:0.1"
		hx-target="this"
		hx-swap="outerHTML"
	>
		for range 6 {
			<div class="w-full space-y-2 md:w-[160px]">
				@skeleton.Skeleton(skeleton.Props{Class: "aspect-[2/3] w-full rounded-lg"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-4/5 rounded"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-1/2 rounded"})
			</div>
		}
	</div>
}

templ personFilmographyCount(loadedCount, total int, outOfBand bool) {
	<p
		id="person-filmography-count"
		class="ml-auto self-end whitespace-nowrap pb-2 text-right text-xs text-muted-foreground"
		if outOfBand {
			hx-swap-oob="outerHTML"
		}
	>
		Showing { loadedCount } of { total }
	</p>
}

func personCreditGroupingKey(credit models.PersonCredit) string {
	return strings.TrimSpace(credit.MediaType) + ":" + strconv.FormatInt(credit.ID, 10)
}

func buildPersonFilmography(actingCredits, crewCredits []models.PersonCredit) []personFilmographyCredit {
	credits := make([]personFilmographyCredit, 0, len(actingCredits)+len(crewCredits))
	indexByKey := make(map[string]int, len(actingCredits)+len(crewCredits))

	addCredit := func(credit models.PersonCredit, isActing, isCrew bool) {
		key := personCreditGroupingKey(credit)
		index, exists := indexByKey[key]
		if !exists {
			index = len(credits)
			indexByKey[key] = index
			credits = append(credits, personFilmographyCredit{Credit: credit})
		}

		entry := &credits[index]
		entry.IsActing = entry.IsActing || isActing
		entry.IsCrew = entry.IsCrew || isCrew
		if isActing {
			entry.RoleKeys = appendUniqueString(entry.RoleKeys, "actor")
			roleName := "Actor"
			if strings.TrimSpace(credit.Role) != "" {
				roleName += " • " + strings.TrimSpace(credit.Role)
			}
			entry.RoleNames = appendUniqueString(entry.RoleNames, roleName)
		}
		if isCrew {
			entry.RoleKeys = appendUniqueString(entry.RoleKeys, personFilmographyCrewRoleKey(credit.Role))
			entry.RoleNames = appendUniqueString(entry.RoleNames, personCrewRoleText(credit))
		}
	}

	for _, credit := range actingCredits {
		addCredit(credit, true, false)
	}
	for _, credit := range crewCredits {
		addCredit(credit, false, true)
	}
	return credits
}

func filterPersonFilmography(credits []personFilmographyCredit, state PersonFilmographyState) []personFilmographyCredit {
	filtered := make([]personFilmographyCredit, 0, len(credits))
	for _, credit := range credits {
		if state.Type == personFilmographyTypeActing && !credit.IsActing || state.Type == personFilmographyTypeCrew && !credit.IsCrew {
			continue
		}
		if state.Media != personFilmographyMediaAll && !strings.EqualFold(state.Media, credit.Credit.MediaType) {
			continue
		}
		if state.Quality == personFilmographyQualityPopular && credit.Credit.VoteCount < personFilmographyMinimumVotes {
			continue
		}
		if state.Role != personFilmographyRoleAll && !containsString(credit.RoleKeys, state.Role) {
			continue
		}
		filtered = append(filtered, credit)
	}
	return filtered
}

func sortPersonFilmography(credits []personFilmographyCredit, sortMode string) []personFilmographyCredit {
	sorted := append([]personFilmographyCredit(nil), credits...)
	sort.SliceStable(sorted, func(i, j int) bool {
		left, right := sorted[i].Credit, sorted[j].Credit
		switch sortMode {
		case personFilmographySortNewest:
			if left.ReleaseDate == nil || right.ReleaseDate == nil {
				return left.ReleaseDate != nil
			}
			return left.ReleaseDate.After(*right.ReleaseDate)
		case personFilmographySortOldest:
			if left.ReleaseDate == nil || right.ReleaseDate == nil {
				return left.ReleaseDate != nil
			}
			return left.ReleaseDate.Before(*right.ReleaseDate)
		case personFilmographySortRating:
			if left.VoteAverage != right.VoteAverage {
				return left.VoteAverage > right.VoteAverage
			}
			if left.VoteCount != right.VoteCount {
				return left.VoteCount > right.VoteCount
			}
		case personFilmographySortPopular:
			if left.Popularity != right.Popularity {
				return left.Popularity > right.Popularity
			}
			if left.VoteCount != right.VoteCount {
				return left.VoteCount > right.VoteCount
			}
		default:
			leftReliable, rightReliable := left.VoteCount >= 100, right.VoteCount >= 100
			if leftReliable != rightReliable {
				return leftReliable
			}
			if left.VoteAverage != right.VoteAverage {
				return left.VoteAverage > right.VoteAverage
			}
			if left.VoteCount != right.VoteCount {
				return left.VoteCount > right.VoteCount
			}
		}
		return strings.ToLower(left.Title) < strings.ToLower(right.Title)
	})
	return sorted
}

func capPersonFilmography(credits []personFilmographyCredit) []personFilmographyCredit {
	if len(credits) <= personFilmographyMaxCredits {
		return credits
	}
	return credits[:personFilmographyMaxCredits]
}

func personFilmographyPage(credits []personFilmographyCredit, sortMode string, page int) ([]personFilmographyCredit, bool, int) {
	if page < 0 {
		page = 0
	}
	if sortMode != personFilmographySortNewest && sortMode != personFilmographySortOldest {
		start := page * personFilmographyPageSize
		if start >= len(credits) {
			return []personFilmographyCredit{}, false, len(credits)
		}
		end := min(start+personFilmographyPageSize, len(credits))
		return credits[start:end], end < len(credits), end
	}

	groups := groupPersonFilmographyByYear(credits)
	pages := make([][]personFilmographyCredit, 0)
	currentPage := make([]personFilmographyCredit, 0, personFilmographyPageSize)
	for _, group := range groups {
		if len(currentPage) > 0 && len(currentPage)+len(group.Credits) > personFilmographyPageSize {
			pages = append(pages, currentPage)
			currentPage = make([]personFilmographyCredit, 0, personFilmographyPageSize)
		}
		currentPage = append(currentPage, group.Credits...)
	}
	if len(currentPage) > 0 {
		pages = append(pages, currentPage)
	}
	if page >= len(pages) {
		return []personFilmographyCredit{}, false, len(credits)
	}
	loadedCount := 0
	for i := 0; i <= page; i++ {
		loadedCount += len(pages[i])
	}
	return pages[page], page < len(pages)-1, loadedCount
}

func groupPersonFilmographyByYear(credits []personFilmographyCredit) []personFilmographyYearGroup {
	groups := make([]personFilmographyYearGroup, 0)
	groupIndexByLabel := make(map[string]int)
	for _, credit := range credits {
		label := "Date unknown"
		if credit.Credit.ReleaseDate != nil {
			label = strconv.Itoa(credit.Credit.ReleaseDate.Year())
		}
		index, exists := groupIndexByLabel[label]
		if !exists {
			index = len(groups)
			groupIndexByLabel[label] = index
			groups = append(groups, personFilmographyYearGroup{Label: label})
		}
		groups[index].Credits = append(groups[index].Credits, credit)
	}
	return groups
}

func personFilmographyRoleOptions(credits []personFilmographyCredit) []personFilmographyRoleOption {
	seen := make(map[string]bool)
	for _, credit := range credits {
		for _, roleKey := range credit.RoleKeys {
			seen[roleKey] = true
		}
	}
	options := make([]personFilmographyRoleOption, 0, len(seen))
	if seen["actor"] {
		options = append(options, personFilmographyRoleOption{Key: "actor", Label: "Actor"})
	}
	for _, role := range models.PersonRoles {
		if seen[role.Key] {
			options = append(options, personFilmographyRoleOption{Key: role.Key, Label: role.Label})
		}
	}
	if seen["crew"] {
		options = append(options, personFilmographyRoleOption{Key: "crew", Label: "Other crew"})
	}
	return options
}

func personFilmographyRoleSelection(selected string, options []personFilmographyRoleOption) string {
	if selected == personFilmographyRoleAll {
		return selected
	}
	for _, option := range options {
		if option.Key == selected {
			return selected
		}
	}
	return personFilmographyRoleAll
}

func personFilmographyCrewRoleKey(role string) string {
	return models.PersonFilmographyCrewRoleKey(role)
}

func appendUniqueString(values []string, value string) []string {
	if containsString(values, value) {
		return values
	}
	return append(values, value)
}

func containsString(values []string, value string) bool {
	for _, existing := range values {
		if existing == value {
			return true
		}
	}
	return false
}

templ personCreditPoster(posterPath, title string) {
	<div class="h-20 w-14 shrink-0 overflow-hidden rounded border border-border/50 bg-muted">
		if posterPath != "" {
			<img
				src={ utils.TMDBImageURL("w342", posterPath) }
				alt={ title }
				loading="lazy"
				class="h-full w-full object-cover"
			/>
		} else {
			<div class="h-full w-full flex items-center justify-center text-muted-foreground">
				@icon.Film(icon.Props{Class: "size-[14px]"})
			</div>
		}
	</div>
}

func personBiographyText(biography string) string {
	trimmedBiography := strings.TrimSpace(biography)
	if trimmedBiography == "" {
		return personBiographyFallbackText
	}

	return trimmedBiography
}

func personBiographyPreview(biography string) (string, bool) {
	text := personBiographyText(biography)
	runes := []rune(text)
	if len(runes) <= personBiographyPreviewLimit {
		return text, false
	}

	const ellipsis = "..."
	return string(runes[:personBiographyPreviewLimit-len(ellipsis)]) + ellipsis, true
}

func personHeroSubtitle(person models.PersonDetailsPage) string {
	heroParts := []string{}

	if department := strings.TrimSpace(person.KnownForDepartment); department != "" {
		heroParts = append(heroParts, department)
	}

	if lifeSpan := personLifeSpanText(person.Birthday, person.Deathday); lifeSpan != "" {
		heroParts = append(heroParts, lifeSpan)
	}

	if placeOfBirth := strings.TrimSpace(person.PlaceOfBirth); placeOfBirth != "" {
		heroParts = append(heroParts, placeOfBirth)
	}

	if len(heroParts) == 0 {
		return "Person details"
	}

	return strings.Join(heroParts, " • ")
}

func personLifeSpanText(birthday *time.Time, deathday *time.Time) string {
	switch {
	case birthday != nil && deathday != nil:
		return fmt.Sprintf("%d-%d", birthday.Year(), deathday.Year())
	case birthday != nil:
		return fmt.Sprintf("Born %d", birthday.Year())
	case deathday != nil:
		return fmt.Sprintf("Died %d", deathday.Year())
	default:
		return ""
	}
}

func personAgeText(birthday *time.Time, deathday *time.Time) string {
	if birthday == nil {
		return personUnknownDetailValue
	}

	ageEndDate := time.Now()
	ageSuffix := "years old"

	if deathday != nil {
		ageEndDate = *deathday
		ageSuffix = "years"
	}

	if ageEndDate.Before(*birthday) {
		return personUnknownDetailValue
	}

	age := ageInYears(*birthday, ageEndDate)
	if age < 0 {
		return personUnknownDetailValue
	}

	return fmt.Sprintf("%d %s", age, ageSuffix)
}

func ageInYears(start time.Time, end time.Time) int {
	years := end.Year() - start.Year()
	if end.Month() < start.Month() || (end.Month() == start.Month() && end.Day() < start.Day()) {
		years--
	}

	return years
}

func personValueOrFallback(value string) string {
	trimmedValue := strings.TrimSpace(value)
	if trimmedValue == "" {
		return personUnknownDetailValue
	}

	return trimmedValue
}

func personCrewRoleText(credit models.PersonCredit) string {
	if strings.TrimSpace(credit.Department) == "" || strings.EqualFold(credit.Role, credit.Department) {
		return credit.Role
	}

	return fmt.Sprintf("%s (%s)", credit.Role, credit.Department)
}

func personCreditHref(credit models.PersonCredit) string {
	if credit.MediaType != personMovieMediaType {
		return ""
	}

	return "/movie/" + strconv.FormatInt(credit.ID, 10)
}

func personCreditDateText(date *time.Time) string {
	if date == nil {
		return "Date unknown"
	}

	return date.Format("2006")
}

func personLatestWatchDateText(movies []models.PersonWatchedMovie) string {
	if len(movies) == 0 {
		return "N/A"
	}

	latest := movies[0].LastWatchedDate
	for _, movie := range movies[1:] {
		if movie.LastWatchedDate.After(latest) {
			latest = movie.LastWatchedDate
		}
	}

	if latest.IsZero() {
		return "N/A"
	}

	return latest.Format("Jan 2006")
}

func personWatchCountText(count int64) string {
	if count == 1 {
		return "1 watch"
	}

	return fmt.Sprintf("%d watches", count)
}

func personWatchRolesText(roles []models.PersonWatchRole) string {
	if len(roles) == 0 {
		return ""
	}

	var builder strings.Builder
	for i, role := range roles {
		if i > 0 {
			builder.WriteString(" • ")
		}

		builder.WriteString(personWatchRoleText(role))
	}

	return builder.String()
}

func personWatchRoleText(role models.PersonWatchRole) string {
	label := strings.TrimSpace(role.Label)
	if label == "" {
		if role.Kind == models.PersonWatchRoleKindActing {
			return "as actor"
		}

		return "Crew"
	}

	if role.Kind == models.PersonWatchRoleKindActing {
		return "as " + label
	}

	return label
}

func personBackdropPath(featuredCredits []personFilmographyCredit) string {
	backdropPaths := make([]string, 0, personFeaturedBackdropLimit)
	seenPaths := make(map[string]struct{}, personFeaturedBackdropLimit)
	movieCount := 0
	for _, credit := range featuredCredits {
		if credit.Credit.MediaType != personMovieMediaType {
			continue
		}
		if movieCount >= personFeaturedBackdropLimit {
			break
		}
		movieCount++
		backdropPath := strings.TrimSpace(credit.Credit.BackdropPath)
		if backdropPath == "" {
			continue
		}
		if _, exists := seenPaths[backdropPath]; exists {
			continue
		}
		seenPaths[backdropPath] = struct{}{}
		backdropPaths = append(backdropPaths, backdropPath)
	}
	if len(backdropPaths) == 0 {
		return ""
	}

	return backdropPaths[rand.IntN(len(backdropPaths))]
}

func personInitials(name string) string {
	nameParts := strings.Fields(name)
	if len(nameParts) == 0 {
		return "?"
	}

	firstInitial := []rune(nameParts[0])[0]
	initials := strings.ToUpper(string(firstInitial))

	if len(nameParts) > 1 {
		secondInitial := []rune(nameParts[1])[0]
		initials += strings.ToUpper(string(secondInitial))
	}

	return initials
}

templ PersonLoading() {
	<div id="person-loading" class="htmx-indicator absolute inset-0 bg-background z-30 pointer-events-none overflow-hidden">
		<div class="p-4 space-y-8">
			<div class="relative -m-4 mb-6 min-h-[280px] bg-muted/50 sm:h-[45vh] sm:max-h-[500px] md:h-[50vh] lg:h-[55vh]">
				<div class="flex h-full items-start p-4 sm:items-center sm:p-6 md:p-8 lg:p-10">
					<div class="max-w-6xl mx-auto w-full">
						<div class="flex flex-row gap-4 sm:gap-6 lg:gap-8 items-start">
							<div class="w-20 sm:w-24 md:w-40 lg:w-48 xl:w-52 flex-shrink-0">
								<div class="aspect-[2/3] rounded-lg bg-muted shadow-lg animate-pulse"></div>
							</div>
							<div class="flex-1 min-w-0 space-y-3 sm:space-y-4">
							@skeleton.Skeleton(skeleton.Props{Class: "h-8 w-2/3 rounded-lg"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-3/4 rounded-lg"})
							<div class="flex flex-wrap gap-2">
								for range 3 {
									@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-24 rounded-full"})
								}
							</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div>
				@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-24 mb-4 rounded-lg"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-full max-w-4xl mb-2 rounded-lg"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-4/5 max-w-4xl mb-2 rounded-lg"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-3/5 max-w-4xl rounded-lg"})
			</div>
			<div>
				@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-16 mb-4 rounded-lg"})
				<div class="space-y-2">
					for range 7 {
						<div class="flex">
							@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/4 rounded-lg"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-1/2 ml-4 rounded-lg"})
						</div>
					}
				</div>
			</div>
			<div>
				@skeleton.Skeleton(skeleton.Props{Class: "h-6 w-32 mb-4 rounded-lg"})
				<div class="grid grid-cols-3 gap-3 px-1 pb-2 sm:grid-cols-4 sm:gap-4">
					for range 6 {
						<div class="w-full space-y-2 md:w-[160px]">
							@skeleton.Skeleton(skeleton.Props{Class: "aspect-[2/3] w-full rounded-lg"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-4/5 rounded"})
							@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-1/2 rounded"})
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}
