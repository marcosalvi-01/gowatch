// Package addtolistdialog contains the UI component for the dialog to add movies to lists.
package addtolistdialog

import (
	"github.com/marcosalvi-01/gowatch/internal/models"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/card"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/label"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/radiogroup"
	"strconv"
)

templ AddToListDialog(lists []models.ListEntry) {
	@radiogroup.RadioGroup(radiogroup.Props{Name: "selected_list", Class: "flex flex-col gap-3"}) {
		for _, list := range lists {
			@label.Label(label.Props{
				For:   "list-" + strconv.Itoa(int(list.ID)),
				Class: "block cursor-pointer",
			}) {
				@card.Card(card.Props{
					Class: "py-0 hover:border-primary/50 has-[:checked]:ring-1 has-[:checked]:ring-primary has-[:checked]:border-primary transition-all",
				}) {
					@card.Content(card.ContentProps{
						Class: "p-3 flex items-start gap-3",
					}) {
						@radiogroup.Item(radiogroup.ItemProps{
							ID:    "list-" + strconv.Itoa(int(list.ID)),
							Value: strconv.Itoa(int(list.ID)),
						})
						<div class="grid gap-1.5">
							<p class="text-sm leading-none font-medium">
								{ list.Name }
							</p>
						</div>
					}
				}
			}
		}
	}
}
