// Package statscollectioncard contains a reusable card for scrollable stats collections.
package statscollectioncard

import (
	"fmt"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/infohint"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/badge"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/card"
	"github.com/marcosalvi-01/gowatch/internal/ui/utils"
)

type Props struct {
	Title       string
	HelpText    string
	Count       int
	EmptyText   string
	CardClass   string
	ScrollClass string
	Controls    templ.Component
}

templ StatsCollectionCard(props Props) {
	@card.Card(card.Props{
		Class: utils.TwMerge("h-full bg-card/40", props.CardClass),
	}) {
		@card.Header(card.HeaderProps{Class: "flex flex-row items-start justify-between space-y-0 gap-2 p-4 pb-0"}) {
			@card.Title(card.TitleProps{Class: "text-sm font-semibold"}) {
				{ props.Title }
			}
			<div class="flex items-center gap-2">
				if props.Count > 0 {
					@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
						{ fmt.Sprintf("%d", props.Count) }
					}
				}
				@infohint.Corner(props.HelpText, props.Title+" help")
			</div>
		}
		@card.Content(card.ContentProps{Class: "p-4 pt-3"}) {
			if props.Controls != nil {
				<div class="mb-3">
					@props.Controls
				</div>
			}
			if props.Count > 0 {
				<div class={ collectionScrollClass(props.ScrollClass) }>
					{ children... }
				</div>
			} else {
				<div class="text-center text-sm text-muted-foreground py-4">{ collectionEmptyText(props.EmptyText) }</div>
			}
		}
	}
}

func collectionEmptyText(text string) string {
	if text == "" {
		return "No data available"
	}

	return text
}

func collectionScrollClass(scrollClass string) string {
	return utils.TwMerge("space-y-2 max-h-72 overflow-y-auto pr-1", scrollClass)
}
