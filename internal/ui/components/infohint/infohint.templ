package infohint

import (
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/icon"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/tooltip"
	"strings"
)

templ iconTooltip(helpText, ariaLabel string) {
	if helpText != "" {
		{{ tooltipID := strings.ToLower(strings.ReplaceAll(ariaLabel, " ", "-")) + "-tooltip" }}
		@tooltip.Tooltip(tooltip.Props{ID: tooltipID}) {
			<span class="inline-flex items-center text-muted-foreground hover:text-foreground cursor-help" aria-label={ ariaLabel } tabindex="0" { tooltip.Trigger(ctx)... }>
				@icon.Info(icon.Props{Class: "size-4"})
			</span>
			@tooltip.Content(tooltip.ContentProps{Side: tooltip.SideTop, Class: "max-w-xs text-xs leading-relaxed"}) {
				{ helpText }
			}
		}
	}
}

templ Corner(helpText, ariaLabel string) {
	@iconTooltip(helpText, ariaLabel)
}

templ LabelMutedXs(label, helpText string) {
	<div class="text-xs text-muted-foreground mb-1 inline-flex items-center gap-1">
		<span>{ label }</span>
		@Corner(helpText, label+" help")
	</div>
}
