// Package sidebar contains the UI component for the application's navigation sidebar.
package sidebar

import (
	"fmt"
	"github.com/marcosalvi-01/gowatch/internal/models"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/avatar"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/badge"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/button"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/collapsible"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/dialog"
	dropdown "github.com/marcosalvi-01/gowatch/internal/ui/shadcn/dropdownmenu"
	form "github.com/marcosalvi-01/gowatch/internal/ui/shadcn/field"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/icon"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/input"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/sidebar"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/skeleton"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcn/textarea"
	"github.com/marcosalvi-01/gowatch/internal/ui/shadcnutils"
)

type Props struct {
	CurrentPage  string
	Collapsed    bool
	ListsOpen    bool
	WatchedCount int64
	Lists        []models.ListEntry
	Watchlist    *models.List
	User         *models.User
}

// Sidebar is the sidebar for the application. It manages state of the page using a script.
// Each menu item should make an htmx request to swap the main-content.
templ Sidebar(props Props) {
	// Dialog must be at top level for proper portal rendering
	@CreateListDialog()
	@ImportDataDialog()
	@sidebar.Sidebar(sidebar.Props{
		ID:          "sidebar",
		Collapsed:   &props.Collapsed,
		Collapsible: sidebar.CollapsibleIcon,
	}) {
		@header()
		@sidebar.Content() {
			@sidebar.Group() {
				@sidebar.Menu(sidebar.MenuProps{Class: "gap-1"}) {
					@homeMenuItem(props.CurrentPage)
					@watchedMenuItem(props.CurrentPage, props.WatchedCount)
					@watchlistMenuItem(props.Watchlist, props.CurrentPage)
					@statsMenuItem(props.CurrentPage)
					if props.User != nil && props.User.Admin {
						@adminMenuItem(props.CurrentPage)
					}
					@sidebar.Separator()
					@listsSection(props.Lists, props.CurrentPage, props.ListsOpen)
				}
			}
		}
		@sidebar.Footer() {
			@sidebar.Menu() {
				@sidebar.MenuItem() {
					@dropdown.DropdownMenu() {
						@sidebar.MenuButton(sidebar.MenuButtonProps{
							Size:       sidebar.MenuButtonSizeLg,
							Tooltip:    "Account",
							Attributes: dropdown.Trigger(ctx),
						}) {
							@avatar.Avatar(avatar.Props{Class: "size-8 rounded-lg"}) {
								@avatar.Image(avatar.ImageProps{
									Src: "/static/favicon.svg",
								})
							}
							<div class="grid flex-1 text-left text-sm leading-tight group-data-[collapsible=icon]:hidden">
								<span class="truncate text-sm font-bold">{ props.User.Name }</span>
							</div>
							@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-4 group-data-[collapsible=icon]:hidden"})
						}
						@dropdown.Content(dropdown.ContentProps{
							Class: "w-56",
							Side:  dropdown.SideTop,
							Align: dropdown.AlignStart,
						}) {
							@dropdown.Label() {
								{ props.User.Email }
							}
							@dropdown.Separator()
							{{ importAttrs := dialog.TriggerFor("import-data-dialog") }}
							{{ delete(importAttrs, "data-slot")
delete(importAttrs, "tabindex") }}
							@dropdown.Item(dropdown.ItemProps{Attributes: utils.MergeAttributes(importAttrs, templ.Attributes{"data-sidebar-import-btn": "true"})}) {
								<span class="flex items-center">
									@icon.Import(icon.Props{Class: "mr-2 size-4"})
									Import data
								</span>
							}
							@dropdown.Item(dropdown.ItemProps{Href: "/api/v1/export", Attributes: templ.Attributes{"download": "gowatch_data.json"}}) {
								@icon.Download(icon.Props{Class: "mr-2 size-4"})
								Export data
							}
							@dropdown.Separator()
							@dropdown.Item(dropdown.ItemProps{
								Attributes: templ.Attributes{
									"hx-post": "/logout",
								},
							}) {
								<span class="flex items-center">
									@icon.LogOut(icon.Props{Class: "mr-2 size-4"})
									Log out
								</span>
							}
						}
					}
				}
			}
		}
	}
}

templ homeMenuItem(currentPage string) {
	@sidebar.MenuItem() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Tooltip:  "Home",
			IsActive: currentPage == "home",
			Attributes: templ.Attributes{
				"data-nav-url": "/home",
				"hx-get":       "/home",
				"hx-target":    "#main-content",
				"hx-swap":      "innerHTML show:#main-scroll-container:top",
				"hx-push-url":  "true",
				"hx-indicator": "#home-loading",
			},
			Class: "cursor-pointer",
		}) {
			@icon.House(icon.Props{Class: "size-4"})
			<span>Home</span>
		}
	}
}

templ watchedMenuItem(currentPage string, watchedCount int64) {
	@sidebar.MenuItem() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Tooltip:  "Watched Movies",
			IsActive: currentPage == "watched",
			Attributes: templ.Attributes{
				"data-nav-url": "/watched",
				"hx-get":       "/watched",
				"hx-target":    "#main-content",
				"hx-swap":      "innerHTML show:#main-scroll-container:top",
				"hx-push-url":  "true",
				"hx-indicator": "#watched-loading",
			},
			Class: "cursor-pointer",
		}) {
			@icon.CheckLine(icon.Props{Class: "size-4"})
			<span>Watched</span>
			if watchedCount > 0 {
				@badge.Badge(badge.Props{
					Variant: badge.VariantSecondary,
					Class:   "ml-auto group-data-[collapsible=icon]:hidden",
				}) {
					{ fmt.Sprintf("%d", watchedCount) }
				}
			}
		}
	}
}

templ statsMenuItem(currentPage string) {
	@sidebar.MenuItem() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Tooltip:  "Statistics",
			IsActive: currentPage == "stats",
			Attributes: templ.Attributes{
				"data-nav-url": "/stats",
				"hx-get":       "/stats",
				"hx-target":    "#main-content",
				"hx-swap":      "innerHTML show:#main-scroll-container:top",
				"hx-push-url":  "true",
				"hx-indicator": "#stats-loading",
			},
			Class: "cursor-pointer",
		}) {
			@icon.ChartBar(icon.Props{Class: "size-4"})
			<span>Stats</span>
		}
	}
}

templ watchlistMenuItem(watchlist *models.List, currentPage string) {
	if watchlist != nil {
		@sidebar.MenuItem() {
			@sidebar.MenuButton(sidebar.MenuButtonProps{
				Tooltip:  "Your Watchlist",
				IsActive: currentPage == "watchlist",
				Attributes: templ.Attributes{
					"data-nav-url": "/watchlist",
					"hx-get":       "/watchlist",
					"hx-target":    "#main-content",
					"hx-swap":      "innerHTML show:#main-scroll-container:top",
					"hx-push-url":  "true",
				},
				Class: "cursor-pointer",
			}) {
				@icon.Bookmark(icon.Props{Class: "size-4"})
				<span>Watchlist</span>
				if len(watchlist.Movies) > 0 {
					@badge.Badge(badge.Props{
						Variant: badge.VariantSecondary,
						Class:   "ml-auto group-data-[collapsible=icon]:hidden",
					}) {
						{ fmt.Sprintf("%d", len(watchlist.Movies)) }
					}
				}
			}
		}
	}
}

templ listsSection(lists []models.ListEntry, currentPage string, listsOpen bool) {
	@sidebar.Group(sidebar.GroupProps{Class: "group-data-[collapsible=icon]:p-0"}) {
		@sidebar.Menu() {
			@sidebar.MenuItem() {
				@collapsible.Collapsible(collapsible.Props{
					DefaultOpen: listsOpen,
					Class:       "group/collapsible w-full",
					Attributes:  templ.Attributes{"data-sidebar-lists-collapsible": "true"},
				}) {
					@listsCollapsibleTrigger()
					@collapsible.Content() {
						@sidebar.MenuSub() {
							@listItems(lists, currentPage)
							@createListTriggerButton()
						}
					}
				}
			}
		}
	}
}

templ listsCollapsibleTrigger() {
	{{ attrs := collapsible.Trigger(ctx) }}
	{{ attrs["data-sidebar-lists-collapsible-trigger"] = "true" }}
	@sidebar.MenuButton(sidebar.MenuButtonProps{
		Tooltip:    "Lists",
		Class:      "cursor-pointer",
		Attributes: attrs,
	}) {
		@icon.List(icon.Props{Class: "size-4"})
		<span>Lists</span>
		@icon.ChevronRight(icon.Props{
			Class: "ml-auto size-4 transition-transform group-data-open/collapsible:rotate-90 group-data-[collapsible=icon]:hidden",
		})
	}
}

templ listItems(lists []models.ListEntry, currentPage string) {
	for _, list := range lists {
		@sidebar.MenuSubItem() {
			@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{
				IsActive: currentPage == fmt.Sprintf("list_%d", list.ID),
				Class:    "cursor-pointer",
				Attributes: templ.Attributes{
					"data-nav-url": fmt.Sprintf("/list/%d", list.ID),
					"hx-get":       fmt.Sprintf("/list/%d", list.ID),
					"hx-target":    "#main-content",
					"hx-swap":      "innerHTML show:#main-scroll-container:top",
					"hx-push-url":  "true",
				},
			}) {
				<span>{ list.Name }</span>
			}
		}
	}
}

templ createListTriggerButton() {
	@sidebar.MenuSubItem() {
		@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{
			Class:      "cursor-pointer",
			Attributes: dialog.TriggerFor("add-to-list-dialog"),
		}) {
			@icon.Plus(icon.Props{Class: "size-[18px]"})
			Create New List
		}
	}
}

templ CreateListDialog() {
	@dialog.Dialog(dialog.Props{
		ID: "add-to-list-dialog",
	}) {
		// Movie page keeps add-list dialog mounted so newly created list can be selected immediately.
		@dialog.Content(dialog.ContentProps{
			Class: "max-w-md",
		}) {
			<form hx-post="/htmx/lists" hx-target="#toast" hx-on::after-request="this.reset(); if (event.detail.successful) { window.templ?.dialog?.open(document.getElementById('add-movie-to-list-dialog')) }">
				@dialog.Header() {
					@dialog.Title() {
						Create New List
					}
					@dialog.Description() {
						Create a new list to keep track of movies.
					}
				}
				@createListFormFields()
				@createListDialogFooter()
			</form>
		}
	}
}

templ createListFormFields() {
	<div class="mb-4 mt-2 space-y-4">
		<div class="space-y-2">
			@form.Field() {
				@form.Label(form.LabelProps{
					For: "add-list-name-input",
				}) {
					Give a name to the list
				}
				@input.Input(input.Props{
					ID:          "add-list-input",
					Placeholder: "A cool name",
					Name:        "title",
				})
			}
			@form.Label(form.LabelProps{
				For: "add-list-description-input",
			}) {
				Give the list a description
			}
			@textarea.Textarea(textarea.Props{
				ID:          "add-list-description-input",
				Placeholder: "A list of funny movies",
				Name:        "description",
			})
		</div>
	</div>
}

templ createListDialogFooter() {
	@dialog.Footer(dialog.FooterProps{Class: "p-2"}) {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Attributes: dialog.Close(ctx),
		}) {
			Cancel
		}
		@button.Button(button.Props{
			Type:       button.TypeSubmit,
			Attributes: templ.Attributes{"data-templ-dialog-close": "add-to-list-dialog"},
		}) {
			Create List
		}
	}
}

templ ImportDataDialog() {
	@dialog.Dialog(dialog.Props{
		ID: "import-data-dialog",
	}) {
		@dialog.Content(dialog.ContentProps{
			Class: "max-w-md",
		}) {
			<form hx-post="/htmx/import" hx-target="#toast" hx-encoding="multipart/form-data">
				@dialog.Header() {
					@dialog.Title() {
						Import data
					}
					@dialog.Description() {
						Upload a JSON file of your exported data.
					}
				}
				@importDataFormFields()
				@importDataDialogFooter()
			</form>
		}
	}
}

templ importDataFormFields() {
	<div class="mb-4 mt-2 space-y-4">
		@form.Field() {
			@form.Label(form.LabelProps{
				For: "import-file-input",
			}) {
				Select JSON File
			}
			@input.Input(input.Props{
				ID:          "import-file-input",
				Type:        "file",
				Name:        "import-file",
				Accept:      ".json",
				Placeholder: "test",
			})
		}
	</div>
}

templ importDataDialogFooter() {
	@dialog.Footer(dialog.FooterProps{Class: "p-2"}) {
		@button.Button(button.Props{
			Variant:    button.VariantOutline,
			Attributes: dialog.Close(ctx),
		}) {
			Cancel
		}
		@button.Button(button.Props{
			Type:       button.TypeSubmit,
			Attributes: templ.Attributes{"data-templ-dialog-close": "import-data-dialog"},
		}) {
			Import data
		}
	}
}

templ header() {
	@sidebar.Header(sidebar.HeaderProps{
		Class: "flex flex-row items-center text-lg font-semibold leading-none tracking-tight",
	}) {
		<div
			hx-get="/home"
			hx-target="#main-content"
			hx-swap="innerHTML show:#main-scroll-container:top"
			hx-push-url="true"
			class="cursor-pointer flex items-center gap-8 group-data-[collapsible=icon]:gap-0"
		>
			<img src="/static/favicon.svg" alt="Gowatch" class="w-20 h-20 group-data-[collapsible=icon]:size-8"/>
			<span class="group-data-[collapsible=icon]:hidden">Gowatch</span>
		</div>
	}
}

// SidebarLoading is just a sidebar without anything inside to show a loading state
templ SidebarLoading(collapsed bool) {
	@sidebar.Sidebar(sidebar.Props{
		ID:          "sidebar",
		Collapsed:   &collapsed,
		Collapsible: sidebar.CollapsibleIcon,
	}) {
		@header()
		@sidebar.Content() {
			@sidebar.Group() {
				@sidebar.Menu() {
					@homeSkeletonItem(collapsed)
					@watchedSkeletonItem(collapsed)
				}
			}
		}
	}
}

templ homeSkeletonItem(collapsed bool) {
	@sidebar.MenuItem() {
		<div class="flex items-center gap-2 px-3 py-2">
			@skeleton.Skeleton(skeleton.Props{Class: "size-4"})
			if !collapsed {
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-16"})
			}
		</div>
	}
}

templ watchedSkeletonItem(collapsed bool) {
	@sidebar.MenuItem() {
		<div class="flex items-center gap-2 px-3 py-2">
			@skeleton.Skeleton(skeleton.Props{Class: "size-4"})
			if !collapsed {
				<div class="flex items-center justify-between flex-1 gap-2">
					@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-20"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-6 rounded-full"})
				</div>
			}
		</div>
	}
}

templ adminMenuItem(currentPage string) {
	@sidebar.MenuItem() {
		@sidebar.MenuButton(sidebar.MenuButtonProps{
			Tooltip:  "Admin",
			IsActive: currentPage == "admin",
			Attributes: templ.Attributes{
				"data-nav-url": "/admin/users",
				"hx-get":       "/admin/users",
				"hx-target":    "#main-content",
				"hx-swap":      "innerHTML show:#main-scroll-container:top",
				"hx-push-url":  "true",
				"hx-indicator": "#admin-loading",
			},
			Class: "cursor-pointer",
		}) {
			@icon.Settings(icon.Props{Class: "size-4 text-primary"})
			<span>Admin</span>
		}
	}
}
