package listgrid

import (
	"fmt"
	"github.com/marcosalvi-01/gowatch/internal/models"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/emptystate"
	"github.com/marcosalvi-01/gowatch/internal/ui/components/moviecard"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/button"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/dialog"
	"github.com/marcosalvi-01/gowatch/internal/ui/templui/icon"
	"github.com/marcosalvi-01/gowatch/internal/utils"
	"strconv"
)

templ ListGrid(data models.ListViewData) {
	if len(data.List.Movies) == 0 {
		if data.List.IsWatchlist {
			@emptystate.EmptyState(emptystate.Props{
				Title:       "Ready to start your movie marathon?",
				Description: "Start building your watchlist by searching for movies you want to see.",
				Instruction: "Use the search bar at the top to find and add movies.",
				ShowImport:  false,
			})
		} else {
			@emptystate.EmptyState(emptystate.Props{
				Title:       "No movies in this list yet",
				Description: "Start building your list by adding movies you want to watch or remember.",
				Instruction: "Use the search bar at the top to find and add movies.",
				ShowImport:  false,
			})
		}
	} else {
		if data.Sort == models.ListMovieSortReleaseStatus {
			<div class="space-y-8 pt-4">
				@comingSoonMovieSection(data.List.ID, data.UpcomingMovies, data.IsEditing, data.List.IsWatchlist)
				@releasedMovieSection(data.List.ID, data.ReleasedMovies, data.IsEditing, data.List.IsWatchlist)
			</div>
		} else {
			<div class="space-y-6 pt-4">
				<div class="space-y-1">
					<h2 class="text-xl font-semibold">Movies</h2>
					if data.Sort == models.ListMovieSortCustom && data.IsEditing {
						<p class="text-sm text-muted-foreground">Reorder movies with arrow controls.</p>
					}
				</div>
				<div class="flex flex-wrap gap-4 md:gap-6 w-full">
					for index, movie := range data.List.Movies {
						@listMovieItem(data.List.ID, movie, data.Sort, data.IsEditing, data.List.IsWatchlist, len(data.List.Movies), index)
					}
				</div>
			</div>
		}
	}
}

templ comingSoonMovieSection(listID int64, movies []models.MovieItem, isEditing, isWatchlist bool) {
	if len(movies) > 0 {
		<div class="space-y-4">
			<h2 class="text-xl font-semibold">Coming Soon</h2>
			<div class="flex flex-wrap gap-4 md:gap-6 w-full">
				for _, movie := range movies {
@releaseStatusMovieItem(listID, movie, comingSoonReleaseDateLabel(movie), isEditing, isWatchlist)
				}
			</div>
		</div>
	}
}

templ releasedMovieSection(listID int64, movies []models.MovieItem, isEditing, isWatchlist bool) {
	if len(movies) > 0 {
		<div class="space-y-4">
			<h2 class="text-xl font-semibold">Released</h2>
			<div class="flex flex-wrap gap-4 md:gap-6 w-full">
				for _, movie := range movies {
@releaseStatusMovieItem(listID, movie, utils.FormatYear(movie.MovieDetails.Movie.ReleaseDate), isEditing, isWatchlist)
				}
			</div>
		</div>
	}
}

templ releaseStatusMovieItem(listID int64, movie models.MovieItem, releaseDateLabel string, isEditing, isWatchlist bool) {
	{{
		class := "relative group space-y-2"
		if !isWatchlist {
			class = "w-[90px] sm:w-[120px] md:w-[160px] space-y-2"
		}
	}}
	<div class={ class }>
		{{
			moviecardProps := moviecard.Props{
				Title:             movie.MovieDetails.Movie.Title,
				Href:              "/movie/" + strconv.Itoa(int(movie.MovieDetails.Movie.ID)),
				PosterPath:        movie.MovieDetails.Movie.PosterPath,
				Hoverable:         true,
				TopHoverComponent: listMovieCardTopHoverInfo(movie),
			}
		}}
		@moviecard.MovieCard(moviecardProps) {
			@movieCardDetails(movie, releaseDateLabel)
		}
		if isEditing {
			@listMovieRemoveAction(listID, movie)
		}
		if isEditing {
			@listConfirmRemoveMovieDialog(listID, movie, isWatchlist)
		}
		if !isWatchlist {
			@listMovieNote(movie)
		}
	</div>
}

templ listMovieItem(listID int64, movie models.MovieItem, sortMode models.ListMovieSort, isEditingOrder, isWatchlist bool, movieCount, index int) {
	{{
		class := "w-[90px] sm:w-[120px] md:w-[160px] space-y-2"
		if isWatchlist {
			class = "relative group space-y-2"
		}
		if isEditingOrder {
			class = "w-[90px] sm:w-[120px] md:w-[160px] flex flex-col items-center space-y-2"
		}
	}}
	<div class={ class }>
		<div class="relative group w-full">
			{{
				moviecardProps := moviecard.Props{
					Title:             movie.MovieDetails.Movie.Title,
					Href:              "/movie/" + strconv.Itoa(int(movie.MovieDetails.Movie.ID)),
					PosterPath:        movie.MovieDetails.Movie.PosterPath,
					Hoverable:         true,
					TopHoverComponent: listMovieCardTopHoverInfo(movie),
				}
			}}
			@moviecard.MovieCard(moviecardProps) {
				@movieCardDetails(movie, utils.FormatYear(movie.MovieDetails.Movie.ReleaseDate))
			}
		</div>
		if isEditingOrder {
			@listMovieRemoveAction(listID, movie)
			@listConfirmRemoveMovieDialog(listID, movie, isWatchlist)
		}
		@listMovieMeta(listID, movie, sortMode, isEditingOrder, movieCount, index)
	</div>
}

templ listMovieMeta(listID int64, movie models.MovieItem, sortMode models.ListMovieSort, isEditingOrder bool, movieCount, index int) {
	if sortMode == models.ListMovieSortCustom && isEditingOrder {
		<form
			class="space-y-2 rounded-lg border bg-background/70 px-2 py-2"
			hx-patch={ fmt.Sprintf("/htmx/lists/%d/items/order", listID) }
			hx-target="#toast"
		>
			<input type="hidden" name="movie_id" value={ strconv.FormatInt(movie.MovieDetails.Movie.ID, 10) }/>
			<div class="flex items-center justify-between gap-2">
				<span class="text-[11px] font-medium text-muted-foreground">{ fmt.Sprintf("Position %d", index+1) }</span>
				<span class="text-[10px] text-muted-foreground">Reorder</span>
			</div>
			<div class="grid grid-cols-4 gap-1">
				@reorderButton("first", "Move to first position", index == 0, icon.ArrowUpToLine(icon.Props{Class: "size-3"}))
				@reorderButton("up", "Move up", index == 0, icon.ChevronUp(icon.Props{Class: "size-3"}))
				@reorderButton("down", "Move down", index == movieCount-1, icon.ChevronDown(icon.Props{Class: "size-3"}))
				@reorderButton("last", "Move to last position", index == movieCount-1, icon.ArrowDownToLine(icon.Props{Class: "size-3"}))
			</div>
		</form>
	} else if movie.Note != nil && *movie.Note != "" {
		@listMovieNote(movie)
	}
}

templ listMovieNote(movie models.MovieItem) {
	if movie.Note != nil && *movie.Note != "" {
		<div class="flex flex-row items-center gap-3 rounded-lg border bg-muted/40 px-2 py-1.5 text-[11px] text-muted-foreground">
			<div class="shrink-0">
				@icon.NotebookPen(icon.Props{Class: "size-3"})
			</div>
			<p class="line-clamp-2 leading-relaxed">{ *movie.Note }</p>
		</div>
	}
}

templ listMovieCardTopHoverInfo(movie models.MovieItem) {
	<div class="flex min-h-[20px] items-center gap-1 text-xs text-muted-foreground">
		@icon.Clock3(icon.Props{Class: "size-5"})
		<span>Added { movie.DateAdded.Format("Jan 2, 2006") }</span>
	</div>
}

templ listMovieRemoveAction(listID int64, movie models.MovieItem) {
	@dialog.Trigger(dialog.TriggerProps{
		For: "list-movie-menu-" + strconv.Itoa(int(listID)) + "-" + strconv.Itoa(int(movie.MovieDetails.Movie.ID)),
	}) {
		@button.Button(button.Props{
			Variant: button.VariantDestructive,
			Size:    button.SizeSm,
			Class:   "w-full gap-2",
		}) {
			@icon.Trash(icon.Props{Class: "size-3"})
			Remove
		}
	}
}

templ reorderButton(move, label string, disabled bool, iconComponent templ.Component) {
	@button.Button(button.Props{
		Type:     button.TypeSubmit,
		Variant:  button.VariantOutline,
		Size:     button.SizeSm,
		Class:    "h-7 w-full min-w-0 p-0",
		Disabled: disabled,
		Attributes: templ.Attributes{
			"name":  "move",
			"value": move,
			"title": label,
		},
	}) {
		@iconComponent
	}
}

templ movieCardDetails(movie models.MovieItem, releaseDateLabel string) {
	<div class="space-y-1.5">
		<h3 class="text-xs sm:text-sm font-bold leading-tight line-clamp-2">
			{ movie.MovieDetails.Movie.Title }
		</h3>
		<div class="flex items-center justify-between text-xs">
			<div class="flex items-center text-muted-foreground">
				@icon.Calendar(icon.Props{Class: "size-3"})
				<span class="ml-1">{ releaseDateLabel }</span>
			</div>
			if movie.MovieDetails.Movie.VoteAverage > 0 {
				<div class="flex items-center">
					@icon.Star(icon.Props{Class: "size-3 fill-[orange] stroke-[orange]"})
					<span class="ml-1">{ fmt.Sprintf("%.1f", movie.MovieDetails.Movie.VoteAverage) }</span>
				</div>
			}
		</div>
	</div>
}

templ listConfirmRemoveMovieDialog(listID int64, movie models.MovieItem, isWatchlist bool) {
	<form
		hx-delete="/htmx/lists/items"
		hx-target="#toast"
	>
		<input type="hidden" name="movie_id" value={ strconv.FormatInt(movie.MovieDetails.Movie.ID, 10) }/>
		<input type="hidden" name="list_id" value={ strconv.FormatInt(listID, 10) }/>
		@dialog.Dialog(dialog.Props{
			ID: "list-movie-menu-" + strconv.Itoa(int(listID)) + "-" + strconv.Itoa(int(movie.MovieDetails.Movie.ID)),
		}) {
			@dialog.Content(dialog.ContentProps{
				Class: "max-w-md",
			}) {
				@dialog.Header() {
					@dialog.Title() {
						Remove Movie
					}
					{{
						var listType string
						if isWatchlist {
							listType = "your watchlist"
						} else {
							listType = "this list"
						}
					}}
					@dialog.Description() {
						Are you sure you want to remove <strong>{ movie.MovieDetails.Movie.Title }</strong> from { listType }?
					}
				}
				@dialog.Footer() {
					@dialog.Close(dialog.CloseProps{
						For: "list-movie-menu-" + strconv.Itoa(int(listID)) + "-" + strconv.Itoa(int(movie.MovieDetails.Movie.ID)),
					}) {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Type:    button.TypeButton,
						}) {
							Cancel
						}
					}
					{{
						var buttonText string
						if isWatchlist {
							buttonText = "Remove from Watchlist"
						} else {
							buttonText = "Remove from List"
						}
					}}
					@dialog.Close(dialog.CloseProps{
						For: "list-movie-menu-" + strconv.Itoa(int(listID)) + "-" + strconv.Itoa(int(movie.MovieDetails.Movie.ID)),
					}) {
						@button.Button(button.Props{
							Variant: button.VariantDestructive,
							Type:    button.TypeSubmit,
						}) {
							{ buttonText }
						}
					}
				}
			}
		}
	</form>
}

func comingSoonReleaseDateLabel(movie models.MovieItem) string {
	releaseDate := movie.MovieDetails.Movie.ReleaseDate
	if releaseDate == nil {
		return "N/A"
	}

	return releaseDate.Format("2 January 2006")
}
